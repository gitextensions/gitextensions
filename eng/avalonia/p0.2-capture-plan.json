        { "id": "go.disabled", "kind": "disabled", "targetField": "goButton" }
      ]
    },
    {
      "typeName": "GitUI.CommandsDialogs.FormCheckoutRevision",
      "states": [
        { "id": "normal", "kind": "normal" },
        { "id": "revision.focused", "kind": "focus", "targetField": "commitPickerSmallControl1" },
        { "id": "force.checked", "kind": "checked", "targetField": "Force" },
        { "id": "checkout.hover", "kind": "hover", "targetField": "OkCheckout" },
        { "id": "checkout.pressed", "kind": "pressed", "targetField": "OkCheckout" },
        { "id": "checkout.disabled", "kind": "disabled", "targetField": "OkCheckout" }
      ]
    },
    {
