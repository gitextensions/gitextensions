      "textValues": {
        "txtSearchBox": "src"
      },
      "states": [
        { "id": "normal", "kind": "normal" },
        { "id": "search.focused", "kind": "focus", "targetField": "txtSearchBox" },
        { "id": "results.focused", "kind": "focus", "targetField": "listBoxSearchResult" },
        { "id": "search.disabled", "kind": "disabled", "targetField": "txtSearchBox" }
      ]
    },
    {
      "typeName": "GitUI.CommandsDialogs.SearchWindow",
      "textValues": {
        "txtSearchBox": "src"
      },
      "states": [
        { "id": "normal", "kind": "normal" },
        { "id": "search.focused", "kind": "focus", "targetField": "txtSearchBox" },
        { "id": "results.focused", "kind": "focus", "targetField": "listBoxSearchResult" }
      ]
    }
