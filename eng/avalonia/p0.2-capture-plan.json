{
  "schemaVersion": 1,
  "settingsProfile": "Profiles/reference.settings.json",
  "scales": [
    100,
    125,
    150,
    200
  ],
  "themes": [
    {
      "id": "light",
      "kind": "builtin",
      "file": "invariant.css",
      "isBuiltin": true
    },
    {
      "id": "dark",
      "kind": "builtin",
      "file": "dark.css",
      "isBuiltin": true
    },
    {
      "id": "parity-custom",
      "kind": "custom",
      "file": "parity-custom.css",
      "isBuiltin": true
    }
  ],
  "components": [
    {
      "typeName": "GitUI.CommandsDialogs.FormDiff",
      "states": [
        { "id": "normal", "kind": "normal" },
        { "id": "files.focused", "kind": "focus", "targetField": "DiffFiles" },
        { "id": "swap.hover", "kind": "hover", "targetField": "btnSwap" },
        { "id": "swap.pressed", "kind": "pressed", "targetField": "btnSwap" },
        { "id": "mergebase.checked", "kind": "checked", "targetField": "ckCompareToMergeBase" },
        { "id": "directory.disabled", "kind": "disabled", "targetField": "btnCompareDirectoriesWithDiffTool" }
      ]
    },
    {
      "typeName": "GitUI.CommandsDialogs.FormCompareToBranch",
      "textValues": {
        "Branches": "feature/visual-parity"
      },
      "states": [
        { "id": "normal", "kind": "normal" },
        { "id": "branch.focused", "kind": "focus", "targetField": "Branches" },
        { "id": "compare.hover", "kind": "hover", "targetField": "btnCompare" },
        { "id": "compare.pressed", "kind": "pressed", "targetField": "btnCompare" },
        { "id": "compare.disabled", "kind": "disabled", "targetField": "btnCompare" }
      ]
    },
    {
      "typeName": "GitUI.CommandsDialogs.FormFormatPatch",
      "textValues": {
        "OutputPath": "patch-output"
      },
      "states": [
        { "id": "normal", "kind": "normal" },
        { "id": "output.focused", "kind": "focus", "targetField": "OutputPath" },
        { "id": "browse.hover", "kind": "hover", "targetField": "Browse" },
        { "id": "browse.pressed", "kind": "pressed", "targetField": "Browse" },
        { "id": "create.hover", "kind": "hover", "targetField": "FormatPatch" },
        { "id": "create.pressed", "kind": "pressed", "targetField": "FormatPatch" },
        { "id": "create.disabled", "kind": "disabled", "targetField": "FormatPatch" }
      ]
    }
  ]
}
