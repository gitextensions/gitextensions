<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Development tool for the Avalonia port: projects input and accessibility metadata
         from matching WinForms Designer files without compiling the Windows UI. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(RepoRoot)\CommonAssemblyInfo.cs" />
  </ItemGroup>

</Project>
