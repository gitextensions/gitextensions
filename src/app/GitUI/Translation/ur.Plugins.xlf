        <target>غیر مرج شدہ برانچز شامل کریں</target>
        
      </trans-unit>
      <trans-unit id="label1.Text">
        <source>Delete branches older than x days</source>
        <target>x دن سے پرانی برانچز حذف کریں</target>
        
      </trans-unit>
      <trans-unit id="label2.Text">
        <source>Delete branches fully merged into branch</source>
        <target>برانچ میں مکمل طور پر مرج شدہ برانچز حذف کریں</target>
        
      </trans-unit>
      <trans-unit id="nameDataGridViewTextBoxColumn.HeaderText">
        <source>Name</source>
        <target>نام</target>
        
      </trans-unit>
      <trans-unit id="regexDoesNotMatch.Text">
        <source>Does not match</source>
        <target>مماثل نہیں</target>
        
      </trans-unit>
      <trans-unit id="regexFilter.Text">
        <source>/(feature|develop)/</source>
        <target>/(feature|develop)/</target>
        
      </trans-unit>
      <trans-unit id="useRegexCaseInsensitive.Text">
        <source>Case insensitive</source>
        <target>بڑے/چھوٹے حروف سے بے نیاز</target>
        
      </trans-unit>
      <trans-unit id="useRegexFilter.Text">
        <source>Use regex to filter branches</source>
        <target>برانچز کو فلٹر کرنے کے لیے RegEx استعمال کریں</target>
        
      </trans-unit>
