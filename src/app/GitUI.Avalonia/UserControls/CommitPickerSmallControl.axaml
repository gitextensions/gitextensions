<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:compat="using:GitUI.Compat"
             xmlns:properties="using:GitUI.Properties"
             x:Class="GitUI.UserControls.CommitPickerSmallControl">
  <Grid x:Name="tableLayoutPanel1" ColumnDefinitions="*,Auto,Auto">
    <TextBox x:Name="textBoxCommitHash" Height="22" Margin="0,2,3,0" MaxLength="100" />
    <compat:IconButton x:Name="buttonPickCommit"
                       Classes="gitextensions-icon-only"
                       Grid.Column="1"
                       Margin="0,0,6,0"
                       Width="25"
                       Height="24"
                       VerticalAlignment="Top"
                       Icon="{x:Static properties:Images.SelectRevision}" />
    <TextBlock x:Name="lbCommits"
               Grid.Column="2"
               Width="1"
               Margin="0,0,2,0"
               Padding="0,5,0,0"
               Opacity="0.65"
               VerticalAlignment="Stretch" />
  </Grid>
</UserControl>
