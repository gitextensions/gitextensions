<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:compat="using:GitUI.Compat"
             xmlns:properties="using:GitUI.Properties"
             x:Class="GitUI.BranchComboBox"
             VerticalContentAlignment="Stretch"
             MinHeight="26">
  <Grid ColumnDefinitions="*,23" ColumnSpacing="4">
    <ComboBox x:Name="branches"
              IsEditable="True"
              Height="23"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Margin="0,3,0,0" />
    <compat:IconButton x:Name="selectMultipleBranchesButton"
                       Classes="gitextensions-icon-only"
                       Grid.Column="1"
                       Width="23"
                       MinHeight="0"
                       Margin="0,1,0,2"
                       VerticalAlignment="Stretch"
                       Padding="2"
                       Icon="{x:Static properties:Images.SelectBranch}" />
  </Grid>
</UserControl>
