<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:compat="using:GitUI.Compat"
             x:Class="GitUI.UserControls.CommitSummaryUserControl">
  <HeaderedContentControl x:Name="groupBox1"
                          compat:TranslationCompat.TranslateText="False"
                          Classes="gitextensions-group-box"
                          Padding="11"
                          Header="...">
    <HeaderedContentControl.HeaderTemplate>
      <DataTemplate>
        <TextBlock Height="16"
                   VerticalAlignment="Center"
                   Text="{Binding}" />
      </DataTemplate>
    </HeaderedContentControl.HeaderTemplate>
    <Grid x:Name="tableLayoutPanel1"
          ColumnDefinitions="85,*"
          RowDefinitions="15,13,21,21,21,31">
      <TextBlock x:Name="labelMessage"
                 Grid.ColumnSpan="2"
                 Height="15"
                 Margin="2,0"
                 FontWeight="Bold"
                 Text="..."
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="labelAuthorCaption" Grid.Row="2" Height="15" Margin="3,3,2,3" VerticalAlignment="Top" Text="Author:" />
      <TextBlock x:Name="labelAuthor" Grid.Row="2" Grid.Column="1" Height="21" Margin="2,0" VerticalAlignment="Top" FontWeight="Bold" Text="..." />
      <TextBlock x:Name="labelDateCaption" Grid.Row="3" Height="15" Margin="3,3,2,3" VerticalAlignment="Top" Text="Commit date:" />
      <TextBlock x:Name="labelDate" Grid.Row="3" Grid.Column="1" Height="21" Margin="2,0" VerticalAlignment="Top" Text="..." />
      <TextBlock x:Name="labelBranchesCaption" Grid.Row="4" Height="15" Margin="3,3,2,3" VerticalAlignment="Top" Text="Branch(es):" />
      <TextBlock x:Name="labelBranches" Grid.Row="4" Grid.Column="1" Height="21" Margin="2,0" VerticalAlignment="Top" Text="..." TextWrapping="Wrap" />
      <TextBlock x:Name="labelTagsCaption" Grid.Row="5" Height="25" Margin="3,3,2,3" VerticalAlignment="Top" Text="Tag(s):" />
      <TextBlock x:Name="labelTags" Grid.Row="5" Grid.Column="1" Height="31" Margin="2,0" VerticalAlignment="Top" Text="..." TextWrapping="Wrap" />
    </Grid>
  </HeaderedContentControl>
</UserControl>
