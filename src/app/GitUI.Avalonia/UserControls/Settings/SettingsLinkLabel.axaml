<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:GitUI.Properties"
             x:Class="GitUI.UserControls.Settings.SettingsLinkLabel">
  <StackPanel x:Name="tableLayoutPanel"
              Orientation="Horizontal"
              Spacing="2"
              VerticalAlignment="Center">
    <HyperlinkButton x:Name="linkLabel"
                     Padding="0" />
    <Button x:Name="pictureBox"
            Classes="gitextensions-icon-only"
            Width="16"
            Height="16"
            Padding="0"
            IsVisible="False">
      <Image Classes="gitextensions-icon-16"
             Source="{x:Static properties:Images.Information}" />
    </Button>
  </StackPanel>
</UserControl>
