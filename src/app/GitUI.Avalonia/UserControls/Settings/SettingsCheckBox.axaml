<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="using:GitUI.Properties"
             x:Class="GitUI.UserControls.Settings.SettingsCheckBox"
             d:DesignWidth="104"
             d:DesignHeight="17">
  <StackPanel x:Name="tableLayoutPanel"
              Orientation="Horizontal"
              Spacing="2">
    <CheckBox x:Name="checkBox"
              Margin="0"
              Content="Settings text" />
    <Image x:Name="pictureBox"
           Classes="gitextensions-icon-16"
           Cursor="Hand"
           IsVisible="False"
           Source="{x:Static properties:Images.Information}" />
  </StackPanel>
</UserControl>
