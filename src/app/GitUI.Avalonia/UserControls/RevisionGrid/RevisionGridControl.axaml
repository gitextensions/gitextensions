<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:GitUI.Properties"
             xmlns:revisionGrid="using:GitUI.UserControls.RevisionGrid"
             xmlns:wf="using:GitUI.Compat.WinFormsControls"
             x:Class="GitUI.RevisionGridControl"
             Background="{DynamicResource GitExtensionsControlBackgroundBrush}"
             Foreground="{DynamicResource GitExtensionsControlForegroundBrush}"
             Design.Width="682"
             Design.Height="235">
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="lblLoadingStatus" Margin="4,2" Opacity="0.7" IsVisible="False" />
    <Grid x:Name="pnlRevisionGrid">
      <ContentControl x:Name="revisionPage"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
      <!-- Avalonia deviation: suppress its container focus adorner because the original borderless grid uses row selection as its focus cue. -->
      <ListBox x:Name="_gridView"
               Classes="revision-grid"
               SelectionMode="Multiple"
               Focusable="True"
               FocusAdorner="{x:Null}"
               Background="{DynamicResource GitExtensionsPanelBackgroundBrush}"
               Foreground="{DynamicResource GitExtensionsControlForegroundBrush}">
      <ListBox.ContextMenu>
        <!-- The 265-DIP ToolStrip item canvas plus its retained one-pixel native border. -->
        <wf:ContextMenuStrip x:Name="mainContextMenu"
                             Classes="gitextensions-revision-context-menu"
                             Width="266">
          <wf:ToolStripMenuItem x:Name="markRevisionAsBadToolStripMenuItem" Header="Mark revision as bad">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BisectBad}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="markRevisionAsGoodToolStripMenuItem" Header="Mark revision as good">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BisectGood}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="bisectSkipRevisionToolStripMenuItem" Header="Skip revision">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BisectSkip}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="stopBisectToolStripMenuItem" Header="Stop bisect">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BisectStop}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepBisect" />
          <revisionGrid:CopyContextMenuItem x:Name="copyToClipboardToolStripMenuItem" />
          <wf:ToolStripSeparator x:Name="sepCopy" />
          <wf:ToolStripMenuItem x:Name="applyStashToolStripMenuItem" Header="Appl_y stash">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Stash}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="popStashToolStripMenuItem" Header="Pop _stash">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Stash}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="dropStashToolStripMenuItem" Header="_Drop stash...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Stash}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepStash" />
          <wf:ToolStripMenuItem x:Name="checkoutBranchToolStripMenuItem" Header="Chec_kout branch...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BranchCheckout}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="tsmiPushBranch" Header="Pus_h branch...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Push}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="mergeBranchToolStripMenuItem" Header="_Merge into current branch...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Merge}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="rebaseOnToolStripMenuItem" Header="_Rebase current branch on">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Rebase}" /></MenuItem.Icon>
            <wf:ToolStripMenuItem x:Name="rebaseToolStripMenuItem" Header="_Selected commit" />
            <wf:ToolStripMenuItem x:Name="rebaseInteractivelyToolStripMenuItem" Header="Selected commit _interactively..." />
            <wf:ToolStripSeparator x:Name="sepRebase" />
            <wf:ToolStripMenuItem x:Name="rebaseWithAdvOptionsToolStripMenuItem" Header="Selected commit with _advanced options..." />
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="resetCurrentBranchToHereToolStripMenuItem" Header="Reset c_urrent branch to here...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.ResetCurrentBranchToHere}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepBranch" />
          <wf:ToolStripMenuItem x:Name="resetChangesToolStripMenuItem" Header="_Reset changes">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.ResetWorkingDirChanges}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="commitToolStripMenuItem" Header="_Commit">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.RepoStateDirty}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="createNewBranchToolStripMenuItem" Header="Create new branch here (_x)..." InputGesture="Ctrl+B">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BranchCreate}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="resetAnotherBranchToHereToolStripMenuItem" Header="Reset an_other branch to here...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.ResetAnotherBranchToHere}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="renameBranchToolStripMenuItem" Header="R_ename branch...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Renamed}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="deleteBranchToolStripMenuItem" Header="_Delete branch...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.BranchDelete}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepBranchModification" />
          <wf:ToolStripMenuItem x:Name="createTagToolStripMenuItem" Header="Create new ta_g here..." InputGesture="Ctrl+T">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.TagCreate}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="deleteTagToolStripMenuItem" Header="_Delete tag...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.TagDelete}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepCommit" />
          <wf:ToolStripMenuItem x:Name="checkoutRevisionToolStripMenuItem" Header="Checkout _this commit...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Checkout}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="revertCommitToolStripMenuItem" Header="Re_vert this commit...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.RevertCommit}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="cherryPickCommitToolStripMenuItem" Header="Cherr_y pick this commit...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.CherryPick}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="archiveRevisionToolStripMenuItem" Header="Arch_ive this commit...">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.ArchiveRevision}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="manipulateCommitToolStripMenuItem" Header="_Advanced">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Advanced}" /></MenuItem.Icon>
            <wf:ToolStripMenuItem x:Name="editCommitToolStripMenuItem" Header="_Edit commit" />
            <wf:ToolStripMenuItem x:Name="rewordCommitToolStripMenuItem" Header="_Reword commit" />
            <wf:ToolStripMenuItem x:Name="fixupCommitToolStripMenuItem" Header="Create a _fixup commit..." />
            <wf:ToolStripMenuItem x:Name="squashCommitToolStripMenuItem" Header="Create a _squash commit..." />
            <wf:ToolStripMenuItem x:Name="amendCommitToolStripMenuItem" Header="Create an _amend commit..." />
            <wf:ToolStripMenuItem x:Name="getHelpOnHowToUseTheseFeaturesToolStripMenuItem" Header="Get _help on how to use these features" />
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepCompare" />
          <wf:ToolStripMenuItem x:Name="compareToolStripMenuItem" Header="Com_pare">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Diff}" /></MenuItem.Icon>
            <wf:ToolStripMenuItem x:Name="openCommitsWithDiffToolMenuItem" Header="Open selected commits with _difftool" />
            <wf:ToolStripSeparator x:Name="sepCompareDropdown" />
            <wf:ToolStripMenuItem x:Name="compareToBranchToolStripMenuItem" Header="Compare _to branch..." />
            <wf:ToolStripMenuItem x:Name="compareWithCurrentBranchToolStripMenuItem" Header="Compare with _current branch" />
            <wf:ToolStripMenuItem x:Name="selectAsBaseToolStripMenuItem" Header="Select _as BASE to compare" />
            <wf:ToolStripMenuItem x:Name="compareToBaseToolStripMenuItem" Header="Compare to _BASE" IsEnabled="False" />
            <wf:ToolStripMenuItem x:Name="compareToWorkingDirectoryMenuItem" Header="Compare to _working directory" />
            <wf:ToolStripMenuItem x:Name="compareSelectedCommitsMenuItem" Header="Compare _selected commits" />
          </wf:ToolStripMenuItem>
          <wf:ToolStripSeparator x:Name="sepNavigate" />
          <wf:ToolStripMenuItem x:Name="navigateToolStripMenuItem" Header="_Navigate">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.GotoCommit}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="tsmiSelectInLeftPanel" Header="Se_lect in left panel">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.FileTree}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="viewToolStripMenuItem" Header="View">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.AdvancedSettings}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="runScriptToolStripMenuItem" Header="Run _script">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Console}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="openBuildReportToolStripMenuItem" Header="View _build report in a browser">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.Integration}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="openPullRequestPageStripMenuItem" Header="Vie_w pull request in a browser">
            <MenuItem.Icon><Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.PullRequest}" /></MenuItem.Icon>
          </wf:ToolStripMenuItem>
          <wf:ToolStripMenuItem x:Name="tsmiOtherActions" Header="_Other actions" />
        </wf:ContextMenuStrip>
      </ListBox.ContextMenu>
      <ListBox.Styles>
        <!-- Rows use the original font- and DPI-derived height: the graph renderer draws each
             row's lane segment assuming adjacent rows abut, so container padding stays zero. -->
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource GitExtensionsHighlightBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource GitExtensionsRevisionSelectedSubjectBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource GitExtensionsHighlightBackgroundBrush}" />
        </Style>
        <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource GitExtensionsInactiveSelectionBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource GitExtensionsControlForegroundBrush}" />
        </Style>
        <Style Selector="ListBox.context-menu-open ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource GitExtensionsHighlightBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource GitExtensionsRevisionSelectedSubjectBrush}" />
        </Style>
        <Style Selector="TextBlock.revision-body">
          <Setter Property="Foreground" Value="{DynamicResource GitExtensionsKnownColorGrayTextBrush}" />
        </Style>
      </ListBox.Styles>
      </ListBox>
      </ContentControl>
    </Grid>
  </DockPanel>
</UserControl>
