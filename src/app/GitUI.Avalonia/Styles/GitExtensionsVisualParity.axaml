<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:compat="using:GitUI.Compat"
        xmlns:converters="using:Avalonia.Controls.Converters"
        xmlns:leftpanel="using:GitUI.LeftPanel">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- WinForms stores fonts in points; these defaults are the equivalent Avalonia
           device-independent-pixel sizes until AppSettings replaces them at startup. -->
      <FontFamily x:Key="GitExtensionsUiFontFamily">Segoe UI</FontFamily>
      <x:Double x:Key="GitExtensionsUiFontSize">12</x:Double>
      <!-- Raw ToolStripRenderer system text colors do not consume custom CSS's
           configurable HighlightText/GrayText/ControlDark resources. -->
      <SolidColorBrush x:Key="GitExtensionsWorkingDirectorySelectedForegroundBrush" Color="#FFFFFF" />
      <FontStyle x:Key="GitExtensionsUiFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsUiFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsCommitFontFamily">Segoe UI</FontFamily>
      <x:Double x:Key="GitExtensionsCommitFontSize">12</x:Double>
      <FontStyle x:Key="GitExtensionsCommitFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsCommitFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsFixedWidthFontFamily">Consolas</FontFamily>
      <x:Double x:Key="GitExtensionsFixedWidthFontSize">13.333333333333334</x:Double>
      <FontStyle x:Key="GitExtensionsFixedWidthFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsFixedWidthFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsMonospaceFontFamily">Consolas</FontFamily>
      <x:Double x:Key="GitExtensionsMonospaceFontSize">12</x:Double>
      <FontStyle x:Key="GitExtensionsMonospaceFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsMonospaceFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsGenericMonospaceFontFamily">Courier New</FontFamily>
      <!-- System.Windows.Forms.TreeView.Indent defaults to 19 at 96 DPI. FileStatusList
           overrides this resource with its source-authored 14-DIP indent. -->
      <x:Double x:Key="GitExtensionsTreeViewItemIndent">19</x:Double>
      <Thickness x:Key="GitExtensionsTreeViewChevronMargin">4,0</Thickness>
      <SolidColorBrush x:Key="GitExtensionsTransparentBrush" Color="Transparent" />
      <SolidColorBrush x:Key="GitExtensionsErrorForegroundBrush" Color="Red" />
      <SolidColorBrush x:Key="GitExtensionsSettingReadOnlyBackgroundBrush" Color="#F0F0F0" />
      <compat:WinFormsFocusAdornerTemplate x:Key="GitExtensionsFocusAdorner" />

      <!-- Avalonia popup descendants live in a detached visual root, so an outer style cannot
           override the Fluent dropdown content margin. Preserve the framework template and
           change only the popup measurements and chrome that differ from native WinForms. -->
      <ControlTheme x:Key="GitExtensionsNativeComboBoxTheme"
                    TargetType="ComboBox"
                    BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Template">
          <ControlTemplate>
            <DataValidationErrors>
              <Grid ColumnDefinitions="*,18">
                <Border x:Name="Background"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        MinWidth="{DynamicResource ComboBoxThemeMinWidth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                <Border x:Name="HighlightBackground"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource ComboBoxBackgroundUnfocused}"
                        BorderBrush="{DynamicResource ComboBoxBackgroundBorderBrushUnfocused}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="False" />
                <TextBlock x:Name="PlaceholderTextBlock"
                           Grid.Column="0"
                           Margin="{TemplateBinding Padding}"
                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           Foreground="{TemplateBinding PlaceholderForeground}"
                           Opacity="{DynamicResource TextControlPlaceholderOpacity}"
                           Text="{TemplateBinding PlaceholderText}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="SelectionBoxItem"
                               RelativeSource="{RelativeSource TemplatedParent}"
                               Converter="{x:Static ObjectConverters.IsNull}" />
                      <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <ContentControl x:Name="ContentPresenter"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
                <TextBox x:Name="PART_EditableTextBox"
                         Grid.Column="0"
                         Padding="{TemplateBinding Padding}"
                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         Foreground="{TemplateBinding Foreground}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsVisible="{TemplateBinding IsEditable}"
                         PlaceholderText="{TemplateBinding PlaceholderText}"
                         Text="{TemplateBinding Text, Mode=TwoWay}">
                  <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
                <Border x:Name="DropDownOverlay"
                        Grid.Column="1"
                        Width="17"
                        Margin="0,1,1,1"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        IsVisible="False" />
                <PathIcon x:Name="DropDownGlyph"
                          Grid.Column="1"
                          Width="7"
                          Height="4"
                          Margin="0,0,5,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                          Foreground="{DynamicResource GitExtensionsWindowTextBrush}"
                          IsHitTestVisible="False"
                          UseLayoutRounding="False" />
                <Popup x:Name="PART_Popup"
                       MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                       MaxHeight="{TemplateBinding MaxDropDownHeight}"
                       InheritsTransform="True"
                       IsLightDismissEnabled="True"
                       IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                       PlacementTarget="Background"
                       WindowManagerAddShadowHint="False">
                  <Border x:Name="PopupBorder"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource GitExtensionsWindowBackgroundBrush}"
                          BorderBrush="{DynamicResource GitExtensionsWindowTextBrush}"
                          BorderThickness="{DynamicResource ComboBoxDropdownBorderThickness}"
                          CornerRadius="0">
                    <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                  IsScrollChainingEnabled="False">
                      <ItemsPresenter x:Name="PART_ItemsPresenter"
                                      Margin="0"
                                      ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </DataValidationErrors>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- ThemeFix deliberately leaves native EDIT chrome unchanged, even in a dark CSS
           theme. Native Fixed3D search inputs retain a light rim and focus underline,
           independently of KnownColor.Highlight or the user's desktop accent. -->
      <SolidColorBrush x:Key="GitExtensionsNativeSearchRimBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="GitExtensionsNativeSearchInnerRimBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GitExtensionsNativeSearchUnderlineBrush" Color="#838383" />
      <SolidColorBrush x:Key="GitExtensionsNativeSearchFocusedUnderlineBrush" Color="#0067C0" />
      <SolidColorBrush x:Key="GitExtensionsNativeLinkActiveBrush" Color="Red" />
      <SolidColorBrush x:Key="GitExtensionsChecklistStatusHoverBrush" Color="#C0C0FF" />
      <SolidColorBrush x:Key="GitExtensionsFileFilterRemovedBrush" Color="#FF0000" />
      <SolidColorBrush x:Key="GitExtensionsFileFilterRenamedBrush" Color="#BD7CFF" />
      <SolidColorBrush x:Key="GitExtensionsFileFilterModifiedBrush" Color="#A8A800" />
      <SolidColorBrush x:Key="GitExtensionsFileFilterAddedBrush" Color="#00A800" />
      <ControlTheme x:Key="GitExtensionsNativeSearchInputTheme"
                    TargetType="TextBox"
                    BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <DataValidationErrors>
              <Panel>
                <Border Name="NativeFrame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource GitExtensionsNativeSearchRimBrush}"
                        BorderThickness="1" />
                <Border Margin="1"
                        BorderBrush="{StaticResource GitExtensionsNativeSearchInnerRimBrush}"
                        BorderThickness="1" />
                <Border Name="NativeUnderline"
                        Height="1"
                        Background="{StaticResource GitExtensionsNativeSearchUnderlineBrush}"
                        VerticalAlignment="Bottom" />
                <ScrollViewer Name="PART_ScrollViewer" Margin="2"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                  <Panel>
                    <TextBlock Name="PART_Placeholder"
                               Text="{TemplateBinding PlaceholderText}"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                      <TextBlock.IsVisible>
                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text"
                                 Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                      </TextBlock.IsVisible>
                    </TextBlock>
                    <TextPresenter Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   CaretBrush="{TemplateBinding CaretBrush}"
                                   CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   SelectionStart="{TemplateBinding SelectionStart}"
                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Panel>
                </ScrollViewer>
              </Panel>
            </DataValidationErrors>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:focus /template/ Border#NativeUnderline">
          <Setter Property="Height" Value="2" />
          <Setter Property="Background" Value="{StaticResource GitExtensionsNativeSearchFocusedUnderlineBrush}" />
        </Style>
      </ControlTheme>

      <!-- WinForms MenuStrip is a compact desktop control: 24px bar, 20px top-level
           items, and 22px dropdown rows. Fluent's defaults are intentionally roomier. -->
      <x:Double x:Key="MenuBarHeight">24</x:Double>
      <Thickness x:Key="MenuBarItemPadding">7,0</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,1</Thickness>
      <Thickness x:Key="MenuInputGestureTextMargin">7,0,0,0</Thickness>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
      <x:Double x:Key="MenuFlyoutThemeMinHeight">0</x:Double>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

      <StreamGeometry x:Key="GitExtensionsSpinnerIncreaseIcon">M0,4 L4,0 L8,4</StreamGeometry>
      <StreamGeometry x:Key="GitExtensionsSpinnerDecreaseIcon">M0,0 L4,4 L8,0</StreamGeometry>
      <ControlTheme x:Key="GitExtensionsCompactSpinnerButtonTheme"
                    TargetType="RepeatButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPointerOver}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPressed}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="GitExtensionsCompactButtonSpinnerTheme"
                    TargetType="ButtonSpinner">
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid ColumnDefinitions="*,18"
                    RowDefinitions="*,*">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.RowSpan="2"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <RepeatButton x:Name="PART_IncreaseButton"
                              Grid.Column="1"
                              Theme="{StaticResource GitExtensionsCompactSpinnerButtonTheme}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1,0,0,1">
                  <PathIcon Width="8"
                            Height="4"
                            Foreground="{TemplateBinding Foreground}"
                            Data="{StaticResource GitExtensionsSpinnerIncreaseIcon}" />
                </RepeatButton>
                <RepeatButton x:Name="PART_DecreaseButton"
                              Grid.Row="1"
                              Grid.Column="1"
                              Theme="{StaticResource GitExtensionsCompactSpinnerButtonTheme}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1,0,0,0">
                  <PathIcon Width="8"
                            Height="4"
                            Foreground="{TemplateBinding Foreground}"
                            Data="{StaticResource GitExtensionsSpinnerDecreaseIcon}" />
                </RepeatButton>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="GitExtensionsWorkingDirectoryDisabledForegroundBrush" Color="#6D6D6D" />
          <SolidColorBrush x:Key="GitExtensionsWorkingDirectoryDisabledArrowBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="GitExtensionsWorkingDirectorySystemSelectionBrush" Color="#0078D7" />
          <SolidColorBrush x:Key="GitExtensionsNativeListHeaderBackgroundBrush"
                           Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsNativeListSelectionBackgroundBrush"
                           Color="#CCE8FF" />
          <SolidColorBrush x:Key="GitExtensionsNativeListInactiveSelectionBackgroundBrush"
                           Color="#D9D9D9" />
          <SolidColorBrush x:Key="GitExtensionsNativeListHotTrackBrush"
                           Color="#0066CC" />
          <SolidColorBrush x:Key="GitExtensionsSelectionBackgroundBrush"
                           Color="#C3C3FF" />
          <SolidColorBrush x:Key="GitExtensionsSelectionPointerOverBackgroundBrush"
                           Color="#B3B3EB" />
          <SolidColorBrush x:Key="GitExtensionsSelectionForegroundBrush"
                           Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsNativeSelectionBackgroundBrush"
                           Color="#0078D7" />
          <SolidColorBrush x:Key="GitExtensionsNativeSelectionForegroundBrush"
                           Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsInactiveSelectionBackgroundBrush"
                           Color="#E6E6E6" />
          <SolidColorBrush x:Key="GitExtensionsPanelBackgroundBrush"
                           Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsRevisionAlternatingRowBrush"
                           Color="#F9F9F9" />
          <SolidColorBrush x:Key="GitExtensionsRevisionAuthoredBrush"
                           Color="#FFFFC8" />
          <SolidColorBrush x:Key="GitExtensionsRevisionSelectedSubjectBrush"
                           Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsRevisionNonRelativeSubjectBrush"
                           Color="#6D6D6D" />
          <SolidColorBrush x:Key="GitExtensionsRevisionNonRelativeSelectedSubjectBrush"
                           Color="#BCBCBC" />
          <SolidColorBrush x:Key="GitExtensionsRevisionSelectedBodyBrush"
                           Color="#BCBCBC" />
          <SolidColorBrush x:Key="GitExtensionsRevisionNonRelativeBodyBrush"
                           Color="#989898" />
          <SolidColorBrush x:Key="GitExtensionsRevisionNonRelativeSelectedBodyBrush"
                           Color="#A1A1A1" />
          <SolidColorBrush x:Key="GitExtensionsWindowTextBrush"
                           Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSelectionBackgroundBrush" Color="#CCE8FF" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSelectionForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSelectionBorderBrush" Color="#0078D4" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSelectionCornerBrush" Color="#CCE4F6" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSelectionAdjacentEdgeBrush" Color="#0078D4" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSelectionInnerCornerBrush" Color="#CCE8FF" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeInactiveSelectionBackgroundBrush" Color="#D9D9D9" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeInactiveSelectionForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeInactiveSelectionBorderBrush" Color="#949494" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeInactiveSelectionCornerBrush" Color="#9D9D9D" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeInactiveSelectionAdjacentEdgeBrush" Color="#949494" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeInactiveSelectionInnerCornerBrush" Color="#D9D9D9" />
          <SolidColorBrush x:Key="GitExtensionsXhtmlLinkForegroundBrush" Color="#0066CC" />
          <SolidColorBrush x:Key="GitExtensionsWindowBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsCommitEditorBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsCommitEditorReadOnlyBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsTextInputBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsDialogControlsBackgroundBrush" Color="#EEEEEE" />
          <SolidColorBrush x:Key="GitExtensionsReadOnlyTextInputBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsDataGridViewGridLineBrush" Color="#646464" />
          <SolidColorBrush x:Key="GitExtensionsDataGridViewSelectionBackgroundBrush" Color="#0078D7" />
          <SolidColorBrush x:Key="GitExtensionsNativeGroupBoxBorderBrush" Color="#DCDCDC" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonBackgroundBrush" Color="#FDFDFD" />
          <x:Boolean x:Key="GitExtensionsNativeFlatButtonDarkMode">False</x:Boolean>
          <x:Boolean x:Key="GitExtensionsNativeToolStripSplitUseSystemVisualStyle">True</x:Boolean>
          <SolidColorBrush x:Key="GitExtensionsNativeToolStripSplitProfessionalSelectedBrush" Color="#B3D7F3" />
          <SolidColorBrush x:Key="GitExtensionsNativeToolStripSplitProfessionalPressedBrush" Color="#80BCEB" />
          <SolidColorBrush x:Key="GitExtensionsNativeToolStripSplitProfessionalBorderBrush" Color="#0078D7" />
          <SolidColorBrush x:Key="GitExtensionsNativeToolStripSplitProfessionalSplitterBrush" Color="#0078D7" />
          <LinearGradientBrush x:Key="GitExtensionsNativeToolStripSplitProfessionalOpenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FCFCFC" />
            <GradientStop Offset="1" Color="#F8F8F8" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="GitExtensionsNativeToolStripSplitProfessionalOpenBorderBrush" Color="#808080" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSearchBackgroundBrush" Color="#FFFFE1" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeSearchForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsNativeTreeDefaultBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsNativeDisabledGutterBackgroundBrush" Color="#F4F7FC" />
          <x:Boolean x:Key="GitExtensionsToolStripSeparatorUseSystemVisualStyle">True</x:Boolean>
          <SolidColorBrush x:Key="GitExtensionsToolStripSeparatorDarkBrush" Color="#BDBDBD" />
          <SolidColorBrush x:Key="GitExtensionsToolStripSeparatorLightBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonHoverBackgroundBrush" Color="#D8D8D8" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonPressedBackgroundBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonDisabledBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonHoverBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonPressedBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonDisabledBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="GitExtensionsNativeFlatButtonFocusBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonBorderBrush" Color="#D0D0D0" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonPointerOverBackgroundBrush" Color="#E0EEF9" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonPointerOverBorderBrush" Color="#0F80D6" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonPressedBackgroundBrush" Color="#CCE4F7" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonPressedBorderBrush" Color="#005499" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonDisabledBackgroundBrush" Color="#F9F9F9" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonDisabledBorderBrush" Color="#E9E9E9" />
          <SolidColorBrush x:Key="GitExtensionsNativeButtonDisabledForegroundBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="GitExtensionsNativeTabBorderBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="GitExtensionsNativeTabSelectedBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsNativeTabUnselectedBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsBrowseTabSelectedBackgroundBrush" Color="#F9F9F9" />
          <SolidColorBrush x:Key="GitExtensionsBrowseTabUnselectedBackgroundBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="GitExtensionsNativeScrollBarBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsNativeScrollBarThumbBrush" Color="#858585" />
          <SolidColorBrush x:Key="GitExtensionsToolStripOverflowBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsNativeTabPageBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="GitExtensionsControlBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsMenuBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="GitExtensionsMenuRenderedBackgroundBrush" Color="#FDFDFD" />
          <SolidColorBrush x:Key="GitExtensionsMenuRenderedBorderBrush" Color="#808080" />
          <SolidColorBrush x:Key="GitExtensionsMenuCheckBackgroundBrush" Color="#B5D7F3" />
          <SolidColorBrush x:Key="GitExtensionsMenuCheckForegroundBrush" Color="#393939" />
          <SolidColorBrush x:Key="GitExtensionsControlForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsSourceControlTextBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsControlBorderBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="GitExtensionsControlPointerOverBackgroundBrush" Color="#E3E3E3" />
          <SolidColorBrush x:Key="GitExtensionsToolStripPointerOverBackgroundBrush" Color="#E5F3FF" />
          <SolidColorBrush x:Key="GitExtensionsToolStripCheckedBackgroundBrush" Color="#CCE8FF" />
          <SolidColorBrush x:Key="GitExtensionsControlPressedBackgroundBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="GitExtensionsDisabledForegroundBrush" Color="#6D6D6D" />
          <SolidColorBrush x:Key="GitExtensionsHighlightBackgroundBrush" Color="#0078D7" />
          <SolidColorBrush x:Key="GitExtensionsHighlightForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsFileStatusSelectionForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsInactiveSelectionForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsSystemInactiveSelectionBackgroundBrush" Color="#BFCDDB" />
          <SolidColorBrush x:Key="GitExtensionsToolTipBackgroundBrush" Color="#FFFFE1" />
          <SolidColorBrush x:Key="GitExtensionsToolTipForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsPaneBorderBrush"
                           Color="#E0E0E0" />
          <SolidColorBrush x:Key="GitExtensionsSectionBorderBrush"
                           Color="#E0E0E0" />
          <SolidColorBrush x:Key="GitExtensionsFileStatusSplitterBrush"
                           Color="#E0E0E0" />
          <SolidColorBrush x:Key="GitExtensionsOtherBackgroundBrush" Color="#FBFBFB" />
          <SolidColorBrush x:Key="GitExtensionsMergeConflictsBackgroundBrush" Color="#E66363" />
          <SolidColorBrush x:Key="GitExtensionsMergeConflictsForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsRefLabelBackgroundBrush"
                           Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsBranchRefBrush"
                           Color="#008000" />
          <SolidColorBrush x:Key="GitExtensionsRemoteBranchRefBrush"
                           Color="#8B0009" />
          <SolidColorBrush x:Key="GitExtensionsTagRefBrush"
                           Color="#00008B" />
          <SolidColorBrush x:Key="GitExtensionsOtherRefBrush"
                           Color="#808080" />
          <SolidColorBrush x:Key="GitExtensionsTreeConnectorBrush"
                           Color="#6D6D6D" />
          <SolidColorBrush x:Key="GitExtensionsValidFilterBackgroundBrush"
                           Color="#C8FFC8" />
          <SolidColorBrush x:Key="GitExtensionsInvalidFilterBackgroundBrush"
                           Color="#FFC8C8" />
          <SolidColorBrush x:Key="GitExtensionsResetSoftBackgroundBrush" Color="#80FF80" />
          <SolidColorBrush x:Key="GitExtensionsResetMixedBackgroundBrush" Color="#FFFF80" />
          <SolidColorBrush x:Key="GitExtensionsResetHardBackgroundBrush" Color="#FF8080" />
          <SolidColorBrush x:Key="GitExtensionsResetSoftForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsResetMixedForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsResetHardForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsDiffEditorBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GitExtensionsDiffTextBrush" Color="#000000" />
          <SolidColorBrush x:Key="GitExtensionsDiffLineNumberBackgroundBrush" Color="#EBEBEB" />
