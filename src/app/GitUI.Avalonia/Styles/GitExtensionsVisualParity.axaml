<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:compat="using:GitUI.Compat"
        xmlns:converters="using:Avalonia.Controls.Converters"
        xmlns:leftpanel="using:GitUI.LeftPanel">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- WinForms stores fonts in points; these defaults are the equivalent Avalonia
           device-independent-pixel sizes until AppSettings replaces them at startup. -->
      <FontFamily x:Key="GitExtensionsUiFontFamily">Segoe UI</FontFamily>
      <x:Double x:Key="GitExtensionsUiFontSize">12</x:Double>
      <FontStyle x:Key="GitExtensionsUiFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsUiFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsCommitFontFamily">Segoe UI</FontFamily>
      <x:Double x:Key="GitExtensionsCommitFontSize">12</x:Double>
      <FontStyle x:Key="GitExtensionsCommitFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsCommitFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsFixedWidthFontFamily">Consolas</FontFamily>
      <x:Double x:Key="GitExtensionsFixedWidthFontSize">13.333333333333334</x:Double>
      <FontStyle x:Key="GitExtensionsFixedWidthFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsFixedWidthFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsMonospaceFontFamily">Consolas</FontFamily>
      <x:Double x:Key="GitExtensionsMonospaceFontSize">12</x:Double>
      <FontStyle x:Key="GitExtensionsMonospaceFontStyle">Normal</FontStyle>
      <FontWeight x:Key="GitExtensionsMonospaceFontWeight">Normal</FontWeight>
      <FontFamily x:Key="GitExtensionsGenericMonospaceFontFamily">Courier New</FontFamily>
      <x:Double x:Key="GitExtensionsTreeViewItemIndent">18</x:Double>
      <Thickness x:Key="GitExtensionsTreeViewChevronMargin">4,0</Thickness>
      <SolidColorBrush x:Key="GitExtensionsTransparentBrush" Color="Transparent" />
      <SolidColorBrush x:Key="GitExtensionsErrorForegroundBrush" Color="Red" />
      <SolidColorBrush x:Key="GitExtensionsInvalidSettingBackgroundBrush" Color="#FFFF8080" />
      <SolidColorBrush x:Key="GitExtensionsInvalidSettingForegroundBrush" Color="Black" />
      <SolidColorBrush x:Key="GitExtensionsInteractiveActionBackgroundBrush" Color="#FF87CEFA" />
      <SolidColorBrush x:Key="GitExtensionsInteractiveActionForegroundBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="GitExtensionsInteractiveConflictBackgroundBrush" Color="#FFFFA500" />
      <SolidColorBrush x:Key="GitExtensionsInteractiveConflictForegroundBrush" Color="#FF000000" />

      <compat:WinFormsFocusAdornerTemplate x:Key="GitExtensionsFocusAdorner" />

      <!-- Avalonia popup descendants live in a detached visual root, so an outer style cannot
           override the Fluent dropdown content margin. Preserve the framework template and
           change only the popup measurements and chrome that differ from native WinForms. -->
      <ControlTheme x:Key="GitExtensionsNativeComboBoxTheme"
                    TargetType="ComboBox"
                    BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Template">
          <ControlTemplate>
            <DataValidationErrors>
              <Grid ColumnDefinitions="*,18">
                <Border x:Name="Background"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        MinWidth="{DynamicResource ComboBoxThemeMinWidth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                <Border x:Name="HighlightBackground"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource ComboBoxBackgroundUnfocused}"
                        BorderBrush="{DynamicResource ComboBoxBackgroundBorderBrushUnfocused}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="False" />
                <TextBlock x:Name="PlaceholderTextBlock"
                           Grid.Column="0"
                           Margin="{TemplateBinding Padding}"
                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           Foreground="{TemplateBinding PlaceholderForeground}"
                           Opacity="{DynamicResource TextControlPlaceholderOpacity}"
                           Text="{TemplateBinding PlaceholderText}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="SelectionBoxItem"
                               RelativeSource="{RelativeSource TemplatedParent}"
                               Converter="{x:Static ObjectConverters.IsNull}" />
                      <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <ContentControl x:Name="ContentPresenter"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
                <TextBox x:Name="PART_EditableTextBox"
                         Grid.Column="0"
                         Padding="{TemplateBinding Padding}"
                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         Foreground="{TemplateBinding Foreground}"
                         Background="Transparent"
                         BorderThickness="0"
                         IsVisible="{TemplateBinding IsEditable}"
                         PlaceholderText="{TemplateBinding PlaceholderText}"
                         Text="{TemplateBinding Text, Mode=TwoWay}">
                  <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
                <Border x:Name="DropDownOverlay"
                        Grid.Column="1"
                        Width="17"
                        Margin="0,1,1,1"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        IsVisible="False" />
                <PathIcon x:Name="DropDownGlyph"
                          Grid.Column="1"
                          Width="7"
                          Height="4"
                          Margin="0,0,5,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                          Foreground="{DynamicResource GitExtensionsWindowTextBrush}"
                          IsHitTestVisible="False"
                          UseLayoutRounding="False" />
                <Popup x:Name="PART_Popup"
                       MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                       MaxHeight="{TemplateBinding MaxDropDownHeight}"
                       InheritsTransform="True"
                       IsLightDismissEnabled="True"
                       IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                       PlacementTarget="Background"
                       WindowManagerAddShadowHint="False">
                  <Border x:Name="PopupBorder"
                          Padding="0"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource GitExtensionsWindowBackgroundBrush}"
                          BorderBrush="{DynamicResource GitExtensionsWindowTextBrush}"
                          BorderThickness="{DynamicResource ComboBoxDropdownBorderThickness}"
                          CornerRadius="0">
                    <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                  IsScrollChainingEnabled="False">
                      <ItemsPresenter x:Name="PART_ItemsPresenter"
                                      Margin="0"
                                      ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </DataValidationErrors>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- WinForms MenuStrip is a compact desktop control: 24px bar, 20px top-level
           items, and 22px dropdown rows. Fluent's defaults are intentionally roomier. -->
      <x:Double x:Key="MenuBarHeight">24</x:Double>
      <Thickness x:Key="MenuBarItemPadding">7,0</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,1</Thickness>
      <Thickness x:Key="MenuInputGestureTextMargin">7,0,0,0</Thickness>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
      <x:Double x:Key="MenuFlyoutThemeMinHeight">0</x:Double>
      <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

      <StreamGeometry x:Key="GitExtensionsSpinnerIncreaseIcon">M0,4 L4,0 L8,4</StreamGeometry>
      <StreamGeometry x:Key="GitExtensionsSpinnerDecreaseIcon">M0,0 L4,4 L8,0</StreamGeometry>
      <ControlTheme x:Key="GitExtensionsCompactSpinnerButtonTheme"
                    TargetType="RepeatButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPointerOver}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPressed}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="GitExtensionsCompactButtonSpinnerTheme"
                    TargetType="ButtonSpinner">
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid ColumnDefinitions="*,18"
                    RowDefinitions="*,*">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.RowSpan="2"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <RepeatButton x:Name="PART_IncreaseButton"
                              Grid.Column="1"
                              Theme="{StaticResource GitExtensionsCompactSpinnerButtonTheme}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1,0,0,1">
                  <PathIcon Width="8"
                            Height="4"
                            Foreground="{TemplateBinding Foreground}"
                            Data="{StaticResource GitExtensionsSpinnerIncreaseIcon}" />
                </RepeatButton>
                <RepeatButton x:Name="PART_DecreaseButton"
                              Grid.Row="1"
                              Grid.Column="1"
                              Theme="{StaticResource GitExtensionsCompactSpinnerButtonTheme}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1,0,0,0">
                  <PathIcon Width="8"
                            Height="4"
                            Foreground="{TemplateBinding Foreground}"
                            Data="{StaticResource GitExtensionsSpinnerDecreaseIcon}" />
                </RepeatButton>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

