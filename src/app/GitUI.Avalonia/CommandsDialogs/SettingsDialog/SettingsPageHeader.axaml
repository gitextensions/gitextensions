<ui:TranslatedControl xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:ui="using:GitUI"
                      x:Class="GitUI.CommandsDialogs.SettingsDialog.SettingsPageHeader">
  <Grid RowDefinitions="58,*"
        Margin="0,4,0,0">
    <ContentControl x:Name="settingsPagePanel"
                    Grid.Row="1"
                    TabIndex="0" />
    <Grid x:Name="HeaderPanel"
          Grid.Row="0"
          TabIndex="1">
      <Grid x:Name="tableLayoutPanel2"
            Height="51"
            RowDefinitions="39,12,7"
            TabIndex="0">
        <Border x:Name="linePanel"
                Grid.Row="1"
                Height="4"
                Margin="3,4"
                TabIndex="0"
                Background="{DynamicResource GitExtensionsKnownColorControlDarkDarkBrush}" />
        <WrapPanel x:Name="flowLayoutPanel1"
                   Grid.Row="0"
                   Height="35"
                   Margin="3,4,3,0"
                   TabIndex="1"
                   VerticalAlignment="Center">
          <TextBlock x:Name="label1"
                     Width="96"
                     Height="15"
                     Margin="3,0"
                     TabIndex="0"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Text="Settings source:" />
          <StackPanel x:Name="tableLayoutPanel1"
                      Orientation="Horizontal"
                      Margin="3,0"
                      TabIndex="1"
                      VerticalAlignment="Center">
            <RadioButton x:Name="EffectiveRB" Margin="3,4" TabIndex="0" Content="Effective" />
            <TextBlock x:Name="arrowLocal" Margin="3,4" TabIndex="1" VerticalAlignment="Center" Text="&lt;&lt;" />
            <RadioButton x:Name="LocalRB" Margin="3,4" TabIndex="2" Content="Local for current repository" />
            <TextBlock x:Name="arrowDistributed" Margin="3,4" TabIndex="3" VerticalAlignment="Center" Text="&lt;&lt;" />
            <RadioButton x:Name="DistributedRB" Margin="3,4" TabIndex="4" Content="Distributed with current repository" />
            <TextBlock x:Name="arrowGlobal" Margin="3,4" TabIndex="5" VerticalAlignment="Center" Text="&lt;&lt;" />
            <RadioButton x:Name="GlobalRB" Width="156" Margin="3,4" TabIndex="6" Content="Global for all repositories" />
            <TextBlock x:Name="arrowSystem" Margin="3,4" TabIndex="7" VerticalAlignment="Center" Text="&lt;&lt;" />
            <RadioButton x:Name="SystemRB" Margin="3,4" TabIndex="8" Content="System" />
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Grid>
  </Grid>
</ui:TranslatedControl>
