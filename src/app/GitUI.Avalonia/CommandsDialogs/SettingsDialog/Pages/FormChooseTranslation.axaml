<gitui:GitExtensionsForm xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:gitui="using:GitUI"
                         x:Class="GitUI.CommandsDialogs.SettingsDialog.Pages.FormChooseTranslation"
                         Width="800"
                         Height="539"
                         MinWidth="500"
                         MinHeight="360"
                         CanResize="True"
                         WindowStartupLocation="CenterScreen"
                         Title="Choose language">
  <Grid Width="800"
        Height="539"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        ColumnDefinitions="12,*,12"
        RowDefinitions="9,15,9,15,3,*,12">
    <TextBlock x:Name="label1"
               Grid.Row="1"
               Grid.Column="1"
               Width="126"
               Height="15"
               HorizontalAlignment="Left"
               Text="Choose your language" />
    <TextBlock x:Name="label2"
               Grid.Row="3"
               Grid.Column="1"
               Width="338"
               Height="15"
               HorizontalAlignment="Left"
               Text="You can change the language at any time in the settings dialog"
               TextWrapping="Wrap" />
    <ListBox x:Name="lvTranslations"
             Grid.Row="5"
             Grid.Column="1" />
  </Grid>
</gitui:GitExtensionsForm>
