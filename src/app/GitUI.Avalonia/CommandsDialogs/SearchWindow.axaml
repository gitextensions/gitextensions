<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitUI.CommandsDialogs.SearchWindow"
        Width="325" Height="213"
        MinWidth="64" MinHeight="45"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title=""
        WindowStartupLocation="CenterOwner">
  <Grid x:Name="tableLayoutPanel1"
        RowDefinitions="Auto,*">
    <Label x:Name="lblEnterFileName"
           Height="24"
           Padding="0,7,0,0"
           BorderThickness="1"
           BorderBrush="{DynamicResource GitExtensionsControlBorderBrush}"
           Background="{DynamicResource GitExtensionsControlBackgroundBrush}"
           Content="Enter File Name"
           HorizontalContentAlignment="Left"
           VerticalContentAlignment="Top" />
    <ContentControl Grid.Row="1" />
  </Grid>
</Window>
