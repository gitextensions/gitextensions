<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gitui="using:GitUI"
        x:Class="GitUI.CommandsDialogs.FormApplyPatch"
        Width="711"
        Height="436"
        MinWidth="704"
        MinHeight="371"
        WindowStartupLocation="CenterOwner"
        Title="Apply patch">
  <Grid x:Name="MainLayoutPanel"
        ColumnDefinitions="574,*"
        RowDefinitions="87,*">
    <Canvas x:Name="PanelTL"
            Margin="3">
      <RadioButton x:Name="PatchFileMode"
                   Canvas.Left="10"
                   Canvas.Top="10"
                   Width="74"
                   Height="19"
                   GroupName="PatchSource"
                   Content="Patch _file"
                   IsChecked="True" />
      <TextBox x:Name="PatchFile"
               Canvas.Left="163"
               Canvas.Top="9"
               Width="281"
               Height="23" />
      <Button x:Name="BrowsePatch"
              Classes="gitextensions-dialog-action"
              Canvas.Left="450"
              Canvas.Top="7"
              Width="100"
              Height="25"
              Content="B_rowse" />

      <RadioButton x:Name="PatchDirMode"
                   Canvas.Left="10"
                   Canvas.Top="35"
                   Width="105"
                   Height="19"
                   GroupName="PatchSource"
                   Content="Patch _directory" />
      <TextBox x:Name="PatchDir"
               Canvas.Left="163"
               Canvas.Top="35"
               Width="281"
               Height="23"
               IsEnabled="False" />
      <Button x:Name="BrowseDir"
              Classes="gitextensions-dialog-action"
              Canvas.Left="450"
              Canvas.Top="33"
              Width="100"
              Height="25"
              Content="Bro_wse"
              IsEnabled="False" />
    </Canvas>

    <Canvas x:Name="PanelTR"
            Grid.Column="1"
            Margin="3">
      <Button x:Name="Apply"
              Classes="gitextensions-dialog-action"
              Canvas.Left="3"
              Canvas.Top="3"
              Width="125"
              Height="25"
              Content="Apply patch"
              IsDefault="True" />
      <CheckBox x:Name="IgnoreWhitespace"
                Canvas.Left="3"
                Canvas.Top="34"
                Width="105"
                Height="19"
                Content="_Ignore Wh.spc." />
      <CheckBox x:Name="SignOff"
                Canvas.Left="3"
                Canvas.Top="59"
                Width="71"
                Height="19"
                Content="Sign-_Off" />
    </Canvas>

    <gitui:PatchGrid x:Name="PatchGrid"
                     Grid.Row="1"
                     Margin="3,2"
                     MinHeight="300" />

    <Canvas x:Name="PanelBR"
            Grid.Row="1"
            Grid.Column="1"
            Margin="3">
      <Border x:Name="MergeToolPanel"
              Canvas.Left="3"
              Canvas.Top="3"
              Width="125"
              Height="31">
        <Button x:Name="Mergetool"
                Classes="gitextensions-dialog-action"
                Margin="3"
                Width="119"
                Height="25"
                Content="_Solve conflicts" />
      </Border>
      <Button x:Name="AddFiles"
              Classes="gitextensions-dialog-action"
              Canvas.Left="3"
              Canvas.Top="61"
              Width="125"
              Height="25"
              Content="_Add files" />
      <Border x:Name="ContinuePanel"
              Canvas.Left="3"
              Canvas.Top="113"
              Width="125"
              Height="32">
        <Button x:Name="Resolved"
                Classes="gitextensions-dialog-action"
                Margin="3"
                Width="119"
                Height="25"
                Content="Conflicts resolved" />
      </Border>
      <Button x:Name="Skip"
              Classes="gitextensions-dialog-action"
              Canvas.Left="3"
              Canvas.Top="151"
              Width="125"
              Height="25"
              Content="S_kip patch" />
      <Button x:Name="Abort"
              Classes="gitextensions-dialog-action"
              Canvas.Left="3"
              Canvas.Top="182"
              Width="125"
              Height="25"
              Content="A_bort patch" />
      <Button x:Name="SolveMergeConflicts"
              Classes="gitextensions-dialog-action"
              Canvas.Left="3"
              Canvas.Top="213"
              Width="125"
              Height="78"
              Content="There are unresolved merge conflicts&#10;"
              IsVisible="False" />
    </Canvas>
  </Grid>
</Window>
