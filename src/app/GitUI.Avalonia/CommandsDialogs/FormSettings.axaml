<gitui:GitModuleForm xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:gitui="using:GitUI"
                     xmlns:settings="using:GitUI.CommandsDialogs.SettingsDialog"
                     x:Class="GitUI.CommandsDialogs.FormSettings"
                     Width="958"
                     Height="746"
                     MinWidth="950"
                     MinHeight="746"
                     CanResize="True"
                     WindowStartupLocation="CenterOwner"
                     Title="Settings">
  <Grid Classes="gitextensions-dialog-main"
        ColumnDefinitions="200,*"
        RowDefinitions="40,*,Auto,Auto"
        Margin="8">
    <settings:SettingsTreeViewUserControl x:Name="settingsTreeView"
                                          Grid.RowSpan="2"
                                          MinWidth="100"
                                          MinHeight="220"
                                          Margin="3" />
    <ContentControl x:Name="panelCurrentSettingsPage"
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Margin="3" />
    <Grid x:Name="flowLayoutPanel4"
          Grid.Row="2"
          Grid.Column="1"
          ColumnDefinitions="*,Auto"
          Margin="3"
          HorizontalAlignment="Right">
      <TextBlock x:Name="labelInstantSaveNotice"
                 VerticalAlignment="Center"
                 TextAlignment="Right"
                 TextWrapping="NoWrap"
                 LineHeight="15"
                 Margin="3,2,3,0"
                 IsVisible="False"
                 Text="Changes on the selected page will be saved instantly. &#10;Therefore the Cancel button does NOT revert any changes made." />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="0,0,8,0">
        <Button x:Name="buttonOk"
                Classes="gitextensions-dialog-action"
                Width="84"
                Height="25"
                Content="OK" />
        <Button x:Name="buttonCancel"
                Classes="gitextensions-dialog-action"
                Width="88"
                Height="25"
                Content="Cancel" />
        <Button x:Name="buttonDiscard"
                Classes="gitextensions-dialog-action"
                Width="88"
                Height="25"
                IsVisible="False"
                Content="Discard" />
        <Button x:Name="buttonApply"
                Classes="gitextensions-dialog-action"
                Width="92"
                Height="25"
                Content="Apply" />
      </StackPanel>
    </Grid>
  </Grid>
</gitui:GitModuleForm>
