<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:GitUI.Compat"
        xmlns:properties="using:GitUI.Properties"
        xmlns:wf="using:GitUI.Compat.WinFormsControls"
        x:Class="GitUI.CommandsDialogs.FormClone"
        Width="647" SizeToContent="Height"
        MinWidth="434" MaxWidth="934" CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Clone">
  <Grid RowDefinitions="Auto,Auto">
    <wf:Panel x:Name="MainPanel"
              Padding="12"
              Background="{DynamicResource GitExtensionsPanelBackgroundBrush}">
    <wf:TableLayoutPanel x:Name="tpnlMain"
          RowDefinitions="Auto,Auto,Auto,Auto">
      <wf:TableLayoutPanel x:Name="tableLayoutPanel1"
          ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="Auto,Auto,Auto,Auto"
          Margin="0">
      <Label x:Name="repositoryLabel"
             Margin="3,0"
             MinWidth="112"
             MinHeight="31"
             Padding="0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             VerticalContentAlignment="Center"
             Content="Repository to _clone:"
             Target="{Binding #_NO_TRANSLATE_From}" />
      <ComboBox x:Name="_NO_TRANSLATE_From"
                Grid.Column="1"
                Margin="3,4"
                HorizontalAlignment="Stretch"
                IsEditable="True" />
      <compat:IconButton x:Name="FromBrowse"
                         Grid.Column="2"
                         Margin="3"
                         MinWidth="94" MinHeight="25"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Center"
                         Icon="{x:Static properties:Images.BrowseFileExplorer}"
                         Content="_Browse" />

      <Label x:Name="destinationLabel"
             Grid.Row="1"
             Margin="3,0"
             Width="70"
             MinHeight="31"
             Padding="0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             VerticalContentAlignment="Center"
             Content="_Destination:"
             Target="{Binding #_NO_TRANSLATE_To}" />
      <ComboBox x:Name="_NO_TRANSLATE_To"
                Grid.Row="1" Grid.Column="1"
                Margin="3,4"
                HorizontalAlignment="Stretch"
                IsEditable="True" />
      <compat:IconButton x:Name="ToBrowse"
                         Grid.Row="1" Grid.Column="2"
                         Margin="3"
                         MinWidth="94" MinHeight="25"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Icon="{x:Static properties:Images.BrowseFileExplorer}"
                         Content="B_rowse" />

      <Label x:Name="subdirectoryLabel"
             Grid.Row="2"
             Margin="3,0"
             Width="126"
             MinHeight="31"
             Padding="0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             VerticalContentAlignment="Center"
             Content="_Subdirectory to create:"
             Target="{Binding #_NO_TRANSLATE_NewDirectory}" />
      <TextBox x:Name="_NO_TRANSLATE_NewDirectory"
               Grid.Row="2" Grid.Column="1"
               Margin="3,4"
               Height="23"
               HorizontalAlignment="Stretch" />

      <Label x:Name="brachLabel"
             Grid.Row="3"
             Margin="3,0"
             Width="47"
             MinHeight="32"
             Padding="0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             VerticalContentAlignment="Center"
             Content="Br_anch:"
             Target="{Binding #_NO_TRANSLATE_Branches}" />
      <ComboBox x:Name="_NO_TRANSLATE_Branches"
                Grid.Row="3" Grid.Column="1"
                Margin="3,4"
                HorizontalAlignment="Stretch"
                IsEditable="True" />
      </wf:TableLayoutPanel>

    <TextBlock x:Name="Info"
               Grid.Row="1"
               Margin="3,13,3,0"
               Height="42"
               Padding="6,4"
               Background="{DynamicResource GitExtensionsKnownColorInfoBrush}"
               TextWrapping="Wrap"
               VerticalAlignment="Top" />

    <HeaderedContentControl x:Name="groupBox1"
                            Classes="gitextensions-group-box"
                            Grid.Row="2"
                            Margin="3,4,3,6"
                            Header="Repository type">
      <StackPanel x:Name="flpnlRepositoryType" Margin="9,4"><RadioButton x:Name="PersonalRepository"
                     MinHeight="19" Padding="0"
                     Content="_Personal repository"
                     IsChecked="True" />
        <RadioButton x:Name="CentralRepository"
                     MinHeight="19" Padding="0"
                     Content="P_ublic repository, no working directory  (--bare)" />
      </StackPanel>
    </HeaderedContentControl>

    <wf:FlowLayoutPanel x:Name="optionsPanel"
                Grid.Row="3"
                Margin="0,7,0,0"
                MinHeight="25"
                HorizontalAlignment="Stretch">
      <StackPanel Orientation="Horizontal">
      <CheckBox x:Name="cbIntializeAllSubmodules"
                Margin="15,3,9,3"
                Width="152"
                Content="Initialize all submodules"
                IsChecked="True" />
      <CheckBox x:Name="cbDownloadFullHistory"
                compat:TranslationCompat.ToolTipPropertyName="ttHints"
                Margin="15,3,9,3"
                Width="139"
                Content="Download full _history"
                IsChecked="True" />
      </StackPanel>
    </wf:FlowLayoutPanel>
    </wf:TableLayoutPanel>
    </wf:Panel>

    <wf:FlowLayoutPanel x:Name="ControlsPanel" Grid.Row="1">
      <Grid ColumnDefinitions="*,Auto,Auto"
            MinHeight="41"
            Background="{DynamicResource GitExtensionsDialogControlsBackgroundBrush}">
      <Button x:Name="Ok" Grid.Column="2"
              Classes="gitextensions-dialog-action"
              Margin="0,8,13,8"
              MinWidth="75"
              MinHeight="25"
              HorizontalAlignment="Right"
              Content="Clone"
              IsDefault="True" />
      <compat:IconButton x:Name="LoadSSHKey" Grid.Column="1"
                         Margin="0,8,6,8"
                         MinWidth="120"
                         MinHeight="25"
                         TabIndex="1"
                         Padding="8,0"
                         HorizontalAlignment="Right"
                         HorizontalContentAlignment="Center"
                         Icon="{x:Static properties:Images.Putty}"
                         Content="_Load SSH key" />
      </Grid>
    </wf:FlowLayoutPanel>
  </Grid>
</Window>
