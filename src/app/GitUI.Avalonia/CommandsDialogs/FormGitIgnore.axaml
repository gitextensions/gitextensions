<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:GitUI.Compat"
        xmlns:editor="clr-namespace:GitUI.Editor"
        xmlns:properties="using:GitUI.Properties"
        x:Class="GitUI.CommandsDialogs.FormGitIgnore"
        Width="634"
        Height="623"
        MinWidth="634"
        MinHeight="459"
        WindowStartupLocation="CenterOwner"
        Padding="4"
        Title="Edit .gitignore">
  <!-- WinForms MinimumSize 650x498 includes its 16x39 native-96 non-client frame; Avalonia sizes the client. -->
  <Grid RowDefinitions="*,33">
    <Grid x:Name="splitContainer1"
          Grid.Row="0"
          ColumnDefinitions="*,6,270"
          TabIndex="0">
      <Grid Grid.Column="0" RowDefinitions="*,33">
        <editor:FileViewer x:Name="_NO_TRANSLATE_GitIgnoreEdit"
                           Grid.Row="0"
                           Margin="0"
                           TabIndex="0" />
        <Canvas x:Name="flowLayoutPanel2"
                Grid.Row="1"
                Margin="0"
                TabIndex="6">
          <Button x:Name="AddDefault"
                  Canvas.Left="3"
                  Canvas.Top="3"
                  Width="160"
                  Height="27"
                  TabIndex="2"
                  Content="Add default ignores" />
          <Button x:Name="AddPattern"
                  Canvas.Left="169"
                  Canvas.Top="3"
                  Width="160"
                  Height="27"
                  TabIndex="3"
                  Content="Add pattern" />
        </Canvas>
      </Grid>

      <GridSplitter Grid.Column="1"
                    Margin="1,0"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="*,42">
        <TextBox x:Name="label1"
                 Grid.Row="0"
                 Margin="0"
                 Padding="0"
                 BorderThickness="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 TabIndex="4"
                 Background="{DynamicResource GitExtensionsKnownColorControlBrush}"
                 Foreground="{DynamicResource GitExtensionsKnownColorControlTextBrush}"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 Text="Specify filepatterns you want git to ignore.&#10;&#10;Example:&#10;#Ignore thumbnails created by Windows&#10;Thumbs.db&#10;#Ignore files built by Visual Studio&#10;*.obj&#10;*.exe&#10;*.pdb&#10;*.user&#10;*.aps&#10;*.pch&#10;*.vspscc&#10;*_i.c&#10;*_p.c&#10;*.ncb&#10;*.suo&#10;*.tlb&#10;*.tlh&#10;*.bak&#10;*.cache&#10;*.ilk&#10;*.log&#10;[Bb]in&#10;[Dd]ebug*/&#10;*.lib&#10;*.sbr&#10;obj/&#10;[Rr]elease*/&#10;_ReSharper*/&#10;[Tt]est[Rr]esult*&#10;.vs/&#10;.idea/&#10;#Nuget packages folder&#10;packages/" />
        <Canvas x:Name="panel1"
                Grid.Row="1"
                Height="42"
                TabIndex="5">
          <!-- Avalonia HyperlinkButton replaces the original LinkLabel. -->
          <HyperlinkButton x:Name="lnkGitIgnoreGenerate"
                           Canvas.Left="62"
                           Canvas.Top="2"
                           Width="197"
                           Height="15"
                           Padding="0"
                           TabIndex="7"
                           Content="Generate a custom ignore file for git" />
          <HyperlinkButton x:Name="lnkGitIgnorePatterns"
                           Canvas.Left="125"
                           Canvas.Top="21"
                           Width="134"
                           Height="15"
                           Padding="0"
                           TabIndex="6"
                           Content="Example ignore patterns" />
        </Canvas>
      </Grid>
    </Grid>

    <Canvas x:Name="flowLayoutPanel1"
            Grid.Row="1"
            Height="33"
            TabIndex="1">
      <compat:IconButton x:Name="Save"
                         Classes="gitextensions-dialog-action"
                         Canvas.Left="463"
                         Canvas.Top="3"
                         Width="160"
                         Height="27"
                         TabIndex="1"
                         Content="Save"
                         Icon="{x:Static properties:Images.Save}"
                         IsDefault="True" />
      <Button x:Name="btnCancel"
              Classes="gitextensions-dialog-action"
              Canvas.Left="382"
              Canvas.Top="3"
              Width="75"
              Height="27"
              TabIndex="2"
              Content="Cancel"
              IsCancel="True" />
    </Canvas>
  </Grid>
</Window>
