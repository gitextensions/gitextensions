<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:compat="using:GitUI.Compat"
        xmlns:properties="using:GitUI.Properties"
        xmlns:usercontrols="clr-namespace:GitUI.UserControls"
        x:Class="GitUI.CommandsDialogs.FormRemotes"
        Width="934" Height="306"
        MinWidth="934" MinHeight="270"
        WindowStartupLocation="CenterOwner"
        Title="Remote repositories">
  <TabControl x:Name="tabControl1" Margin="8">
    <TabItem x:Name="tabPage1" Header="Remote repositories">
      <Grid ColumnDefinitions="240,*" ColumnSpacing="10" Margin="0,8,0,0">
        <Grid x:Name="panel1" RowDefinitions="*,Auto">
          <ListBox x:Name="Remotes" />
          <StackPanel x:Name="panelButtons"
                      Grid.Row="1"
                      Margin="0,6,0,0"
                      Orientation="Horizontal"
                      Spacing="4">
            <compat:IconButton x:Name="New"
                               Classes="gitextensions-icon-only"
                               MinWidth="34"
                               Icon="{x:Static properties:Images.RemoteAdd}" />
            <compat:IconButton x:Name="Delete"
                               Classes="gitextensions-icon-only"
                               MinWidth="34"
                               Icon="{x:Static properties:Images.RemoteDelete}" />
            <compat:IconButton x:Name="btnToggleState"
                               Classes="gitextensions-icon-only"
                               MinWidth="34"
                               Icon="{x:Static properties:Images.EyeOpened}" />
          </StackPanel>
        </Grid>

        <Grid x:Name="pnlManagementContainer" Grid.Column="1">
          <HeaderedContentControl x:Name="gbMgtPanel"
                                  Classes="gitextensions-group-box"
                                  Header="Create New Remote">
            <Grid x:Name="flpnlRemoteManagement"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="8"
                  VerticalAlignment="Top">
              <Grid x:Name="pnlMgtDetails">
                <Grid x:Name="tblpnlMgtDetails"
                      ColumnDefinitions="Auto,*,110"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="6">
            <Label x:Name="label1"
                   Padding="0"
                   Content="_Name"
                   Target="{Binding #RemoteName}"
                   VerticalAlignment="Center" />
            <TextBox x:Name="RemoteName"
                     Grid.Column="1" Grid.ColumnSpan="2"
                     compat:TranslationCompat.TranslateText="False" />

            <Label x:Name="label2"
                   Grid.Row="1"
                   Padding="0"
                   Content="_Url"
                   Target="{Binding #Url}"
                   VerticalAlignment="Center" />
            <usercontrols:CaseSensitiveComboBox x:Name="Url"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      IsEditable="True"
                      compat:TranslationCompat.TranslateText="False" />
            <usercontrols:FolderBrowserButton x:Name="folderBrowserButtonUrl"
                                              Grid.Row="1" Grid.Column="2" />

            <CheckBox x:Name="checkBoxSepPushUrl"
                      Grid.Row="2" Grid.Column="1"
                      Content="Sep_arate Push Url" />

            <Label x:Name="labelPushUrl"
                   Grid.Row="3"
                   Padding="0"
                   Content="_Push Url"
                   Target="{Binding #comboBoxPushUrl}"
                   IsVisible="False"
                   VerticalAlignment="Center" />
            <usercontrols:CaseSensitiveComboBox x:Name="comboBoxPushUrl"
                      Grid.Row="3" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      IsVisible="False"
                      IsEditable="True"
                      compat:TranslationCompat.TranslateText="False" />
            <usercontrols:FolderBrowserButton x:Name="folderBrowserButtonPushUrl"
                                              Grid.Row="3" Grid.Column="2"
                                              IsVisible="False" />

            <TextBlock x:Name="lblRemoteColor"
                       Grid.Row="4"
                       Text="Color"
                       VerticalAlignment="Center" />
            <StackPanel x:Name="flpnlRemoteColors"
                        Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="6">
              <colorPicker:ColorPicker x:Name="btnRemoteColor"
                                       MinWidth="80"
                                       Content="Set _color"
                                       IsAlphaEnabled="False" />
              <Button x:Name="btnRemoteColorReset"
                      Content="Default color"
                      IsVisible="False" />
            </StackPanel>

            <TextBlock x:Name="lblRemotePrefix"
                       Grid.Row="5"
                       Text="Prefix"
                       VerticalAlignment="Center" />
            <TextBox x:Name="txtRemotePrefix"
                     Grid.Row="5" Grid.Column="1"
                     compat:TranslationCompat.TranslateText="False" />

                </Grid>
              </Grid>

              <Grid x:Name="pnlMgtPuttySsh"
                  Grid.Row="1"
                  Margin="0,2,0,0"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock x:Name="lblMgtPuttyPanelHeader"
                           Text="PuTTY SSH"
                           FontWeight="SemiBold" />
                <Border x:Name="lblHeaderLine2"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource GitExtensionsSectionBorderBrush}"
                        BorderThickness="0,1,0,0" />
              </Grid>
              <Grid x:Name="tableLayoutPanel1"
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    ColumnDefinitions="Auto,*,104"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="8"
                    RowSpacing="6">
                <Label x:Name="label3"
                       Padding="0"
                       MinWidth="100"
                       Content="Private _key file"
                       Target="{Binding #PuttySshKey}"
                       VerticalAlignment="Center" />
                <TextBox x:Name="PuttySshKey"
                         Grid.Column="1"
                         compat:TranslationCompat.TranslateText="False" />
                <compat:IconButton x:Name="SshBrowse"
                                   Grid.Column="2"
                                   MinWidth="104"
                                   Icon="{x:Static properties:Images.FileNew}"
                                   Content="Brows_e..." />
                <StackPanel
                            Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="6">
                  <compat:IconButton x:Name="LoadSSHKey"
                                     MinWidth="160"
                                     Icon="{x:Static properties:Images.Putty}"
                                     Content="_Load SSH key" />
                  <compat:IconButton x:Name="TestConnection"
                                     MinWidth="160"
                                     Icon="{x:Static properties:Images.Putty}"
                                     Content="_Test connection" />
                </StackPanel>
              </Grid>
            </Grid>

              <StackPanel x:Name="flowLayoutPanel2"
                          Grid.Row="2"
                          HorizontalAlignment="Right">
                <compat:IconButton x:Name="Save"
                                   Classes="gitextensions-dialog-action"
                                   MinWidth="120"
                                   Icon="{x:Static properties:Images.Save}"
                                   Content="_Save changes" />
              </StackPanel>
            </Grid>
          </HeaderedContentControl>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem x:Name="tabPage2" Header="Default pull behavior (fetch &amp; merge)">
      <Grid x:Name="tableLayoutPanel2" RowDefinitions="*,Auto" Margin="0,8,0,0">
        <Grid x:Name="columnsGrid" RowDefinitions="Auto,*">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="BranchName"
                  Padding="6,4"
                  BorderBrush="{DynamicResource GitExtensionsSectionBorderBrush}"
                  BorderThickness="0,0,1,1">
            <TextBlock Text="Local branch name" FontWeight="SemiBold" />
          </Border>
          <Border x:Name="RemoteCombo"
                  Grid.Column="1"
                  Padding="6,4"
                  BorderBrush="{DynamicResource GitExtensionsSectionBorderBrush}"
                  BorderThickness="0,0,1,1">
            <TextBlock Text="Remote repository" FontWeight="SemiBold" />
          </Border>
          <Border x:Name="MergeWith"
                  Grid.Column="2"
                  Padding="6,4"
                  BorderBrush="{DynamicResource GitExtensionsSectionBorderBrush}"
                  BorderThickness="0,0,1,1">
            <TextBlock Text="Default merge with" FontWeight="SemiBold" />
          </Border>
          <ListBox x:Name="RemoteBranches"
                   Grid.Row="1" Grid.ColumnSpan="3" />
        </Grid>

        <Grid x:Name="panelDetails"
              Grid.Row="1"
              Margin="0,10,0,0"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="8" RowSpacing="6">
          <Label x:Name="label4"
                 Padding="0"
                 Content="_Local branch name"
                 Target="{Binding #LocalBranchNameEdit}"
                 VerticalAlignment="Center" />
          <TextBox x:Name="LocalBranchNameEdit"
                   Grid.Column="1"
                   IsReadOnly="True"
                   compat:TranslationCompat.TranslateText="False" />

          <Label x:Name="label5"
                 Grid.Row="1"
                 Padding="0"
                 Content="_Remote repository"
                 Target="{Binding #RemoteRepositoryCombo}"
                 VerticalAlignment="Center" />
          <ComboBox x:Name="RemoteRepositoryCombo"
                    Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    compat:TranslationCompat.TranslateText="False" />

          <Label x:Name="label6"
                 Grid.Row="2"
                 Padding="0"
                 Content="_Default merge with"
                 Target="{Binding #DefaultMergeWithCombo}"
                 VerticalAlignment="Center" />
          <ComboBox x:Name="DefaultMergeWithCombo"
                    Grid.Row="2" Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    IsEditable="True"
                    compat:TranslationCompat.TranslateText="False" />

          <compat:IconButton x:Name="SaveDefaultPushPull"
                             Classes="gitextensions-dialog-action"
                             Grid.Row="2" Grid.Column="2"
                             MinWidth="120"
                             VerticalAlignment="Bottom"
                             Icon="{x:Static properties:Images.Save}"
                             Content="_Save changes" />
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
