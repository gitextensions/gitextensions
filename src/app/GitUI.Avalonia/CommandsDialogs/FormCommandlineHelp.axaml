<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitUI.CommandsDialogs.FormCommandlineHelp"
        Width="394" Height="662"
        MinWidth="394" MinHeight="662"
        WindowStartupLocation="CenterOwner"
        Title="Commandline usage">
  <StackPanel x:Name="flowLayoutPanel1" Orientation="Vertical">
    <TextBlock x:Name="label1"
               Width="373" Height="52"
               Margin="3,0,0,0"
               HorizontalAlignment="Left"
               Padding="10"
               TextWrapping="Wrap"
               Text="Supported commandline arguments for&#10;gitex.cmd / gitex (located in the same folder as GitExtensions.exe):" />
    <TextBlock x:Name="_NO_TRANSLATE_commands"
               Width="382" Height="649"
               Margin="3,0,0,0"
               HorizontalAlignment="Left"
               Padding="10,0,10,10"
               TextWrapping="NoWrap" />
  </StackPanel>
</Window>
