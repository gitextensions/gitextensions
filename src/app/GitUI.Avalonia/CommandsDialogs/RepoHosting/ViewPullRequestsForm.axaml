<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:GitUI.Editor"
        xmlns:gitui="using:GitUI"
        xmlns:spellChecker="using:GitUI.SpellChecker"
        xmlns:usercontrols="using:GitUI.UserControls"
        xmlns:winformsControls="using:GitUI.Compat.WinFormsControls"
        x:Class="GitUI.CommandsDialogs.RepoHosting.ViewPullRequestsForm"
        Width="754"
        Height="511"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="View Pull Requests">
  <Window.Styles>
    <Style Selector="ComboBox#_selectHostedRepoCB:disabled">
      <Setter Property="Background" Value="{DynamicResource GitExtensionsWindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GitExtensionsWindowTextBrush}" />
    </Style>
    <Style Selector="ListBox.repository-host-discussion">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.repository-host-discussion ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.repository-host-discussion ListBoxItem:pointerover,
                     ListBox.repository-host-discussion ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource GitExtensionsKnownColorControlTextBrush}" />
    </Style>
  </Window.Styles>
  <winformsControls:SplitContainer x:Name="splitContainer2"
        RowDefinitions="146*,6,359*">
    <winformsControls:TableLayoutPanel x:Name="tableLayoutPanel2"
          RowDefinitions="33,*">
      <winformsControls:FlowLayoutPanel x:Name="flowLayoutPanel2"
                                        Margin="2">
        <StackPanel Orientation="Horizontal">
          <winformsControls:Label x:Name="_chooseRepo"
                                  Width="106"
                                  Height="15"
                                  Margin="3,0"
                                  VerticalAlignment="Center"
                                  Text="Choose repository:" />
          <ComboBox x:Name="_selectHostedRepoCB"
                    Width="258"
                    Height="23"
                    Margin="3"
                    VerticalContentAlignment="Center" />
        </StackPanel>
      </winformsControls:FlowLayoutPanel>

      <winformsControls:TableLayoutPanel x:Name="tableLayoutPanel3"
            Grid.Row="1"
            Margin="2"
            ColumnDefinitions="*,Auto">
        <Grid Margin="3"
              RowDefinitions="24,*">
          <!-- Framework constraint: the native ListView client is four DIPs narrower than its outer bounds. -->
          <Grid Margin="0,0,4,0"
                ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <winformsControls:ColumnHeader x:Name="columnHeaderId"
                            Classes="gitextensions-list-header-cell"
                            Content="#" />
            <winformsControls:ColumnHeader x:Name="columnHeaderHeading"
                            Grid.Column="1"
                            Classes="gitextensions-list-header-cell"
                            Content="Heading" />
            <winformsControls:ColumnHeader x:Name="columnHeaderBy"
                            Grid.Column="2"
                            Classes="gitextensions-list-header-cell"
                            Content="By" />
            <winformsControls:ColumnHeader x:Name="columnHeaderCreated"
                            Grid.Column="3"
                            Classes="gitextensions-list-header-cell"
                            Content="Created" />
            <winformsControls:ColumnHeader x:Name="columnHeaderBranch"
                            Grid.Column="4"
                            Classes="gitextensions-list-header-cell"
                            Content="Will be fetched to branch" />
          </Grid>
          <usercontrols:NativeListView x:Name="_pullRequestsList"
                   Grid.Row="1"
                   Classes="gitextensions-native-list-items"
                   SelectionMode="Single" />
        </Grid>

        <winformsControls:FlowLayoutPanel x:Name="flowLayoutPanel3"
                                          Grid.Column="1"
                                          Width="160"
                                          Margin="2">
          <StackPanel>
            <Button x:Name="_fetchBtn"
                  Classes="gitextensions-dialog-action gitextensions-native-dialog-action"
                  Width="155"
                  Height="29"
                  MinHeight="0"
                  Margin="3"
                  HorizontalAlignment="Left"
                  Content="Fetch to pr/ branch" />
            <Button x:Name="_addAndFetchBtn"
                  Classes="gitextensions-dialog-action gitextensions-native-dialog-action"
                  Width="155"
                  Height="29"
                  MinHeight="0"
                  Margin="3"
                  HorizontalAlignment="Left"
                  Content="Add remote and fetch" />
            <Button x:Name="_closePullRequestBtn"
                  Classes="gitextensions-dialog-action gitextensions-native-dialog-action"
                  Width="155"
                  Height="29"
                  MinHeight="0"
                  Margin="3"
                  HorizontalAlignment="Left"
                  Content="Close pull request" />
          </StackPanel>
        </winformsControls:FlowLayoutPanel>
      </winformsControls:TableLayoutPanel>
    </winformsControls:TableLayoutPanel>

    <GridSplitter Grid.Row="1"
                  ResizeDirection="Rows" />

    <TabControl x:Name="tabControl1"
                Grid.Row="2"
                Classes="gitextensions-native-tabs"
                Margin="0"
                Padding="0">
      <winformsControls:TabPage x:Name="tabPage1"
               Classes="gitextensions-dialog-tab"
               Height="28"
               MinHeight="28"
               Padding="8,2"
               Header="Diffs">
        <winformsControls:SplitContainer x:Name="splitContainer3"
              Margin="6,2,6,6"
              RowDefinitions="112*,6,203*">
          <gitui:FileStatusList x:Name="_fileStatusList" />
          <GridSplitter Grid.Row="1"
                        ResizeDirection="Rows" />
          <editor:FileViewer x:Name="_diffViewer"
                             Grid.Row="2" />
        </winformsControls:SplitContainer>
      </winformsControls:TabPage>

      <winformsControls:TabPage x:Name="tabPage2"
               Classes="gitextensions-dialog-tab"
               Height="28"
               MinHeight="28"
               Padding="8,2"
               Header="Comments">
        <winformsControls:TableLayoutPanel x:Name="tableLayoutPanel1"
              Margin="6,2,6,6"
              RowDefinitions="*,80,33">
          <usercontrols:WebBrowserControl x:Name="_discussionWB"
                   Classes="repository-host-discussion"
                   Margin="3"
                   Focusable="True"
                   Background="{DynamicResource GitExtensionsKnownColorControlBrush}"
                   Foreground="{DynamicResource GitExtensionsKnownColorControlTextBrush}"
                   SelectionMode="Single" />
          <spellChecker:EditNetSpell x:Name="_postCommentText"
                                     Classes="repository-host-comment-editor"
                                     Grid.Row="1"
                                     Margin="2"
                                     Background="{DynamicResource GitExtensionsKnownColorControlBrush}"
                                     Foreground="{DynamicResource GitExtensionsKnownColorControlTextBrush}" />
          <winformsControls:FlowLayoutPanel x:Name="flowLayoutPanel1"
                                            Grid.Row="2"
                                            Margin="2">
            <DockPanel LastChildFill="False">
              <Button x:Name="_refreshCommentsBtn"
                    Classes="gitextensions-dialog-action gitextensions-native-dialog-action"
                    Width="100"
                    Height="23"
                    MinHeight="0"
                    Margin="3"
                    DockPanel.Dock="Right"
                    Content="Refresh" />
              <Button x:Name="_postComment"
                    Classes="gitextensions-dialog-action-primary gitextensions-native-dialog-action"
                    Width="131"
                    Height="23"
                    MinHeight="0"
                    Margin="3"
                    DockPanel.Dock="Right"
                    Content="Post comment" />
            </DockPanel>
          </winformsControls:FlowLayoutPanel>
        </winformsControls:TableLayoutPanel>
      </winformsControls:TabPage>
    </TabControl>
  </winformsControls:SplitContainer>
</Window>
