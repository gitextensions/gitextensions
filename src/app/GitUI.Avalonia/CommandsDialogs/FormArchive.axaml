<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:GitUI.Compat"
        xmlns:properties="using:GitUI.Properties"
        xmlns:userControls="using:GitUI.UserControls"
        xmlns:wf="using:GitUI.Compat.WinFormsControls"
        x:Class="GitUI.CommandsDialogs.FormArchive"
        Width="594"
        Height="571"
        MinWidth="594"
        MinHeight="571"
        WindowStartupLocation="CenterOwner"
        Title="Archive">
  <wf:TableLayoutPanel x:Name="tableLayoutPanel4"
        RowDefinitions="30,166,320,55">
    <TextBlock x:Name="label1"
               Margin="3,7,0,0"
               Width="161"
               Height="15"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Text="This revision will be archived:" />

    <Grid Grid.Row="1"
          ColumnDefinitions="479,*">
      <userControls:CommitSummaryUserControl x:Name="commitSummaryUserControl1"
                                             Margin="16,3,5,3"
                                             Width="458"
                                             Height="160" />
      <wf:FlowLayoutPanel x:Name="flowLayoutPanel1"
                  Grid.Column="1"
                  Margin="0,2,2,2"
                  HorizontalAlignment="Stretch">
        <Canvas Width="109" Height="162">
        <TextBlock x:Name="label2"
                   Canvas.Left="2"
                   Width="91"
                   Height="30"
                   Text="Choose another&#10;revision:" />
        <Button x:Name="btnChooseRevision"
                Classes="gitextensions-icon-only"
                Canvas.Left="2"
                Canvas.Top="33"
                Width="25"
                Height="24"
                Padding="3"
                HorizontalAlignment="Left">
          <Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.SelectRevision}" />
        </Button>
        </Canvas>
      </wf:FlowLayoutPanel>
    </Grid>

    <HeaderedContentControl x:Name="groupBox2"
                            Classes="gitextensions-group-box"
                            Grid.Row="2"
                            Margin="3,20,3,0"
                            Header="Filter files">
      <Canvas>
        <TextBox x:Name="textBoxPaths"
                 Canvas.Left="13"
                 Canvas.Top="28"
                 Width="553"
                 Height="75"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="label4"
                   Canvas.Left="16"
                   Canvas.Top="106"
                   Width="194"
                   Height="15"
                   Text="separate each new path by new line" />
        <CheckBox x:Name="checkboxRevisionFilter"
                  Canvas.Left="-2"
                  Canvas.Top="143"
                  Width="504"
                  Content="Take the files that have changed from the revision above to this one and archive only those" />
        <CheckBox x:Name="checkBoxPathFilter"
                  Canvas.Left="-2"
                  Canvas.Top="3"
                  Width="167"
                  Content="Archive specific paths only" />

          <HeaderedContentControl x:Name="gbDiffRevision"
                                  Classes="gitextensions-group-box"
                                  Canvas.Left="5"
                                  Canvas.Top="168"
                                  Width="458"
                                  Height="100"
                                  Header="...">
            <Canvas>
              <TextBlock x:Name="labelMessage"
                         Canvas.Left="-3"
                         Canvas.Top="-5"
                         Width="422"
                         Height="50"
                         FontWeight="Bold"
                         Text="..."
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="labelAuthorCaption"
                         Canvas.Left="-3"
                         Canvas.Top="54"
                         Width="47"
                         Height="15"
                         Text="Author:" />
              <TextBlock x:Name="labelAuthor"
                         Canvas.Left="90"
                         Canvas.Top="55"
                         Width="122"
                         Height="15"
                         FontWeight="Bold"
                         Text="..."
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="labelDateCaption"
                         Canvas.Left="219"
                         Canvas.Top="54"
                         Width="201"
                         Height="15"
                         Text="Commit date:" />
            </Canvas>
          </HeaderedContentControl>

            <TextBlock x:Name="lblChooseDiffRevision"
                       Canvas.Left="471"
                       Canvas.Top="174"
                       Width="112"
                       Height="35"
                       Text="Choose revision to &#10;compare with first:" />
            <Button x:Name="btnDiffChooseRevision"
                    Classes="gitextensions-icon-only"
                    Canvas.Left="471"
                    Canvas.Top="210"
                    Width="25"
                    Height="24"
                    Padding="3"
                    HorizontalAlignment="Left">
              <Image Classes="gitextensions-icon-16" Source="{x:Static properties:Images.SelectRevision}" />
            </Button>
      </Canvas>
    </HeaderedContentControl>

    <Canvas Grid.Row="3">
      <HeaderedContentControl x:Name="groupBox1"
                              Classes="gitextensions-group-box"
                              Canvas.Left="365"
                              Canvas.Top="6"
                              Width="109"
                              Height="48"
                              Header="Archive format">
        <wf:TableLayoutPanel x:Name="tableLayoutPanel2"
                            Margin="-5"
                            ColumnDefinitions="51,52">
          <RadioButton x:Name="_NO_TRANSLATE_radioButtonFormatZip"
                       Margin="3"
                       Width="40"
                       GroupName="ArchiveFormat"
                       Content="zip"
                       IsChecked="True" />
          <RadioButton x:Name="_NO_TRANSLATE_radioButtonFormatTar"
                       Grid.Column="1"
                       Margin="3"
                       Width="39"
                       GroupName="ArchiveFormat"
                       Content="tar" />
        </wf:TableLayoutPanel>
      </HeaderedContentControl>
      <compat:IconButton x:Name="buttonArchiveRevision"
                         Classes="gitextensions-dialog-action"
                         Canvas.Left="480"
                         Canvas.Top="29"
                         Width="111"
                         Height="25"
                         Icon="{x:Static properties:Images.SaveAs}"
                         Content="Save as..." />
    </Canvas>
  </wf:TableLayoutPanel>
</Window>
