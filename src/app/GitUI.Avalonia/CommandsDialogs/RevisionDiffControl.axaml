<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gitui="clr-namespace:GitUI"
             xmlns:blame="clr-namespace:GitUI.Blame"
             xmlns:editor="clr-namespace:GitUI.Editor"
             xmlns:wf="using:GitUI.Compat.WinFormsControls"
             x:Class="GitUI.CommandsDialogs.RevisionDiffControl">
  <Grid x:Name="DiffSplitContainer"
        ColumnDefinitions="380,0,*"
        Background="{DynamicResource GitExtensionsKnownColorControlBrush}">
    <Border Grid.Column="0" Classes="gitextensions-section">
      <wf:SplitContainer x:Name="LeftSplitContainer" Background="Transparent">
        <gitui:FileStatusList x:Name="DiffFiles" GroupByRevision="True" />
      </wf:SplitContainer>
    </Border>
    <GridSplitter x:Name="DiffSplitter" Grid.Column="1" ResizeDirection="Columns" />
    <Border Grid.Column="2" Classes="gitextensions-section">
      <Grid>
        <editor:FileViewer x:Name="DiffText" />
        <blame:BlameControl x:Name="BlameControl" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
