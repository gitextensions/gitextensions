<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:GitUI.Compat"
        xmlns:properties="using:GitUI.Properties"
        xmlns:usercontrols="using:GitUI.UserControls"
        xmlns:wf="using:GitUI.Compat.WinFormsControls"
        x:Class="GitUI.CommandsDialogs.FormPush"
        Width="584"
        Height="290"
        MinWidth="584"
        MinHeight="290"
        CanResize="True"
        Title="Push">
  <Window.Styles>
    <Style Selector="wf|GroupBox.remote-source-group">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Margin="0,8,0,0"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="1" />
            <ContentPresenter Margin="7,0,0,0"
                              Padding="3,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Background="{TemplateBinding Background}"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Grid Classes="gitextensions-dialog-main"
        RowDefinitions="80,*,25">
    <wf:GroupBox x:Name="groupBox2"
                 Classes="remote-source-group"
                 Height="80"
                 Margin="0,0,4,0"
                 Header="Push to">
      <Grid Width="556"
            Height="80"
            Margin="-3,-19,0,0">
        <RadioButton x:Name="PushToRemote"
                     Margin="14,19,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Content="_Remote"
                     IsChecked="True" />
        <ComboBox x:Name="_NO_TRANSLATE_Remotes"
                  Height="23"
                  Margin="128,19,166,0"
                  VerticalAlignment="Top" />
        <compat:IconButton x:Name="AddRemote"
                           Classes="gitextensions-native-dialog-action"
                           Width="150"
                           Height="25"
                           Margin="0,17,10,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Icon="{x:Static properties:Images.Remotes}"
                           Content="_Manage remotes" />

        <RadioButton x:Name="PushToUrl"
                     Margin="14,49,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Content="U_rl" />
        <ComboBox x:Name="PushDestination"
                  Height="23"
                  Margin="128,48,166,0"
                  VerticalAlignment="Top"
                  IsEditable="True"
                  IsEnabled="False"
                  compat:TranslationCompat.TranslateText="False" />
        <usercontrols:FolderBrowserButton x:Name="folderBrowserButton1"
                                          Width="100"
                                          Height="25"
                                          Margin="0,47,60,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          IsEnabled="False" />
      </Grid>
    </wf:GroupBox>

    <TabControl x:Name="TabControlTagBranch"
                Grid.Row="1"
                Classes="gitextensions-native-tabs"
                Margin="0,6,0,6"
                Padding="0"
                SelectedIndex="0">
      <wf:TabPage x:Name="BranchTab"
                  Classes="gitextensions-dialog-tab"
                  Header="Push branches">
        <Grid>
          <Label x:Name="labelFrom"
                 Classes="gitextensions-dialog-label"
                 Width="79"
                 Height="13"
                 Margin="6,15,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Content="_Branch to push"
                 Target="{Binding #_NO_TRANSLATE_Branch}" />
          <wf:TableLayoutPanel x:Name="tableLayoutPanel1"
                               Width="417"
                               Height="22"
                               Margin="124,12,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               ColumnDefinitions="196,24,197">
            <ComboBox x:Name="_NO_TRANSLATE_Branch"
                      Height="21"
                      HorizontalAlignment="Stretch"
                      IsEditable="True" />
            <Label x:Name="labelTo"
                   Classes="gitextensions-dialog-label"
                   Grid.Column="1"
                   Margin="4,3,2,0"
                   Content="_to"
                   Target="{Binding #RemoteBranch}" />
            <ComboBox x:Name="RemoteBranch"
                      Grid.Column="2"
                      Height="21"
                      HorizontalAlignment="Stretch"
                      IsEditable="True"
                      compat:TranslationCompat.TranslateText="False" />
          </wf:TableLayoutPanel>

          <HyperlinkButton x:Name="ShowOptions"
                           Width="75"
                           Height="18"
                           Margin="6,40,0,0"
                           Padding="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Content="Show options" />

          <wf:Panel x:Name="PushOptionsPanel"
                    Height="83"
                    Margin="8,40,7,0"
                    VerticalAlignment="Top"
                    IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto">
              <StackPanel x:Name="ForcePushOptionPanel"
                          Orientation="Horizontal">
                <CheckBox x:Name="ckForceWithLease"
                          Content="_Force with lease" />
                <CheckBox x:Name="ForcePushBranches"
                          Margin="12,0,0,0"
                          Content="F_orce push" />
              </StackPanel>
              <StackPanel x:Name="flowLayoutPanel1"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          Orientation="Horizontal">
                <Label x:Name="label2"
                       Classes="gitextensions-dialog-label"
                       Margin="0,0,8,0"
                       Content="Recursive _submodules"
                       Target="{Binding #RecursiveSubmodules}" />
                <ComboBox x:Name="RecursiveSubmodules"
                          Width="120"
                          compat:TranslationCompat.TranslateText="False" />
              </StackPanel>
              <CheckBox x:Name="ReplaceTrackingReference"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,6,0,0"
                        Content="R_eplace tracking reference" />
              <CheckBox x:Name="_createPullRequestCB"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,6,0,0"
                        Content="_Create pull request after push" />
            </Grid>
          </wf:Panel>
        </Grid>
      </wf:TabPage>

      <wf:TabPage x:Name="TagTab"
                  Classes="gitextensions-dialog-tab"
                  Header="Push tags">
        <Grid>
          <Label x:Name="label1"
                 Classes="gitextensions-dialog-label"
                 Margin="6,15,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Content="_Tag to push"
                 Target="{Binding #TagComboBox}" />
          <ComboBox x:Name="TagComboBox"
                    Height="23"
                    Margin="124,12,166,0"
                    VerticalAlignment="Top"
                    IsEditable="True"
                    compat:TranslationCompat.TranslateText="False" />
          <CheckBox x:Name="ForcePushTags"
                    Margin="124,43,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="_Force push" />
        </Grid>
      </wf:TabPage>

      <wf:TabPage x:Name="MultipleBranchTab"
                  Classes="gitextensions-dialog-tab"
                  Header="Push multiple branches">
        <Grid Margin="4"
              RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="2*,2*,110,65,65,120">
            <Border x:Name="LocalColumn"
                    Padding="4,3"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="1">
              <TextBlock Text="Local Branch" />
            </Border>
            <Border x:Name="RemoteColumn"
                    Grid.Column="1"
                    Padding="4,3"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="0,1,1,1">
              <TextBlock Text="Remote Branch" />
            </Border>
            <Border x:Name="NewColumn"
                    Grid.Column="2"
                    Padding="4,3"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="0,1,1,1">
              <TextBlock Text="Ahead/Behind" />
            </Border>
            <Border x:Name="PushColumn"
                    Grid.Column="3"
                    Padding="4,3"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="0,1,1,1">
              <Border.ContextMenu>
                <ContextMenu x:Name="menuPushSelection">
                  <MenuItem x:Name="unselectAllToolStripMenuItem"
                            Header="Unselect all" />
                  <MenuItem x:Name="selectTrackedToolStripMenuItem"
                            Header="Select tracked" />
                  <MenuItem x:Name="selectAllToolStripMenuItem"
                            Header="Select all" />
                </ContextMenu>
              </Border.ContextMenu>
              <TextBlock Text="Push" />
            </Border>
            <Border x:Name="ForceColumn"
                    Grid.Column="4"
                    Padding="4,3"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="0,1,1,1">
              <TextBlock Text="Force" />
            </Border>
            <Border x:Name="DeleteColumn"
                    Grid.Column="5"
                    Padding="4,3"
                    BorderBrush="{DynamicResource GitExtensionsPaneBorderBrush}"
                    BorderThickness="0,1,1,1">
              <TextBlock Text="Delete Remote Branch" />
            </Border>
          </Grid>
          <ListBox x:Name="BranchGrid"
                   Classes="gitextensions-stretch-items"
                   Grid.Row="1" />
        </Grid>
      </wf:TabPage>
    </TabControl>

    <Grid Grid.Row="2"
          ColumnDefinitions="Auto,*,Auto,Auto">
      <compat:IconButton x:Name="Pull"
                         Classes="gitextensions-native-dialog-action"
                         Grid.Column="0"
                         Width="101"
                         Height="25"
                         Margin="-1,0,0,0"
                         Content="P_ull" />
      <compat:IconButton x:Name="LoadSSHKey"
                         Classes="gitextensions-native-dialog-action"
                         Grid.Column="2"
                         Width="137"
                         Height="25"
                         Margin="0,0,18,0"
                         Icon="{x:Static properties:Images.Putty}"
                         IsVisible="False"
                         Content="_Load SSH key" />
      <compat:IconButton x:Name="Push"
                         compat:TranslationCompat.TranslateText="False"
                         Classes="gitextensions-dialog-action gitextensions-native-dialog-action"
                         Grid.Column="3"
                         Width="101"
                         Height="25"
                         Margin="0,0,1,0"
                         Icon="{x:Static properties:Images.ArrowUp}"
                         IsDefault="True" />
    </Grid>
  </Grid>
</Window>
