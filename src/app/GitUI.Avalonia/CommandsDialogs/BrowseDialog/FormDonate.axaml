<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:GitUI.Compat"
        xmlns:properties="using:GitUI.Properties"
        x:Class="GitUI.CommandsDialogs.BrowseDialog.FormDonate"
        Width="508" Height="266"
        WindowStartupLocation="CenterOwner"
        Padding="16"
        Title="Donate">
  <Grid x:Name="tableLayoutPanel" RowDefinitions="*,80">
    <TextBlock x:Name="lblText"
               Grid.Row="0"
               Margin="10"
               TextWrapping="Wrap"
               compat:TranslationCompat.TranslateText="False" />
    <Image x:Name="pbxDonate"
           Grid.Row="1"
           Margin="12"
           Cursor="Hand"
           Stretch="Uniform"
           StretchDirection="Both"
           Source="{x:Static properties:Images.DonateBadge}" />
  </Grid>
</Window>
