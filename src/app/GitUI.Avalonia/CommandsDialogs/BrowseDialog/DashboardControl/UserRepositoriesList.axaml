<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:compat="using:GitUI.Compat"
             xmlns:wf="using:GitUI.Compat.WinFormsControls"
             xmlns:controls="using:GitUI.UserControls"
             xmlns:properties="using:GitUI.Properties"
             x:Class="GitUI.CommandsDialogs.BrowseDialog.DashboardControl.UserRepositoriesList">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DashboardRepositoryHoverBrush" Color="#DBEBF8" />
          <SolidColorBrush x:Key="DashboardGroupDividerBrush" Color="#B2C1E0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DashboardRepositoryHoverBrush" Color="#202020" />
          <SolidColorBrush x:Key="DashboardGroupDividerBrush" Color="#2D2D2D" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Explorer's native grouped ListView uses TEXTSTYLE, not the configurable
           HotTrack used by the owner-drawn repository branch names. -->
      <SolidColorBrush x:Key="DashboardGroupHeadingBrush" Color="#003399" />
      <SolidColorBrush x:Key="DashboardGroupTaskBrush" Color="#0066CC" />
      <!-- The native ListView task is a text link, not a Fluent button. -->
      <ControlTheme x:Key="DashboardGroupActionTheme" TargetType="Button">
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              Background="{StaticResource GitExtensionsTransparentBrush}"
                              BorderThickness="0"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ListBoxItem.repository-tile:pointerover Grid.repository-tile-content,
                     ListBoxItem.repository-tile:selected Grid.repository-tile-content,
                     ListBoxItem.repository-tile:selected:pointerover Grid.repository-tile-content,
                     ListBox:not(:focus-within) ListBoxItem.repository-tile:selected Grid.repository-tile-content">
      <Setter Property="Background" Value="{DynamicResource DashboardRepositoryHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.repository-group:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBoxItem.repository-group:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBoxItem.repository-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBoxItem.repository-tile:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox:not(:focus-within) ListBoxItem.repository-tile:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource GitExtensionsTransparentBrush}" />
    </Style>
    <Style Selector="Button.dashboard-group-action">
      <Setter Property="Theme" Value="{StaticResource DashboardGroupActionTheme}" />
      <Setter Property="Foreground" Value="{StaticResource DashboardGroupTaskBrush}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Background" Value="{StaticResource GitExtensionsTransparentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.repository-group, ListBoxItem.repository-tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <wf:Panel x:Name="pnlHeader"
              Height="73"
              MinWidth="450"
              HorizontalAlignment="Left"
              Padding="20,0,20,11">
      <wf:TableLayoutPanel x:Name="tableLayoutPanel1"
                           VerticalAlignment="Bottom"
                           Margin="0">
        <wf:Label x:Name="lblRecentRepositories"
                  FontSize="22"
                  Text="Recent repositories"
                  Margin="0"
                  VerticalAlignment="Stretch" />
      </wf:TableLayoutPanel>
    </wf:Panel>
    <wf:Panel x:Name="pnlBody"
              Grid.Row="1"
              Margin="0"
              Padding="20,18,20,3">
      <wf:TableLayoutPanel x:Name="tableLayoutPanel2"
                           ColumnDefinitions="445"
                           ClipToBounds="True"
                           RowDefinitions="45,*"
                           Margin="0">
        <TextBox x:Name="textBoxSearch"
                 Theme="{StaticResource GitExtensionsNativeSearchInputTheme}"
                 Foreground="{DynamicResource GitExtensionsKnownColorWindowTextBrush}"
                 compat:TranslationCompat.TranslateWatermark="False"
                 Margin="3"
                 Height="23"
                 VerticalAlignment="Top" />
        <controls:NativeListView x:Name="listView1"
                                 Grid.Row="1"
                                 Margin="0,3"
                                 Background="{DynamicResource ThemeBackgroundBrush}"
                                 BorderThickness="0"
                                 Focusable="True"
                                 FocusAdorner="{x:Null}"
                                 SelectionMode="Single">
          <ListBox.ContextMenu>
            <wf:ContextMenuStrip x:Name="contextMenuStripRepository">
              <wf:ToolStripMenuItem x:Name="tsmiOpenFolder"
                                    Header="Show in folder"
                                    Icon="{x:Static properties:Images.BrowseFileExplorer}" />
              <wf:ToolStripSeparator x:Name="toolStripMenuItem1" />
              <wf:ToolStripMenuItem x:Name="tsmiCategories"
                                    Header="Categories">
                <wf:ToolStripMenuItem x:Name="tsmiCategoryNone"
                                      Header="(none)" />
                <wf:ToolStripMenuItem x:Name="tsmiCategoryAdd"
                                      Header="Add new..."
                                      Icon="{x:Static properties:Images.BulletAdd}" />
              </wf:ToolStripMenuItem>
              <wf:ToolStripSeparator x:Name="toolStripMenuItem2" />
              <wf:ToolStripMenuItem x:Name="tsmiRemoveFromList"
                                    Header="Remove project from the list" />
              <wf:ToolStripMenuItem x:Name="tsmiRemoveMissingReposFromList"
                                    Header="Remove missing projects from the list" />
            </wf:ContextMenuStrip>
          </ListBox.ContextMenu>
        </controls:NativeListView>
      </wf:TableLayoutPanel>
    </wf:Panel>
    <Border IsVisible="False">
      <Border.ContextMenu>
        <wf:ContextMenuStrip x:Name="contextMenuStripCategory">
          <wf:ToolStripMenuItem x:Name="tsmiCategoryRename"
                                Header="Rename category"
                                Icon="{x:Static properties:Images.FileStatusModified}" />
          <wf:ToolStripMenuItem x:Name="tsmiCategoryDelete"
                                Header="Delete category"
                                Icon="{x:Static properties:Images.StarRemove}" />
          <wf:ToolStripMenuItem x:Name="tsmiCategoryClear"
                                Header="Clear all recent repositories"
                                Icon="{x:Static properties:Images.CleanupRepo}" />
        </wf:ContextMenuStrip>
      </Border.ContextMenu>
    </Border>
    <wf:MenuStrip x:Name="menuStripRecentMenu"
                  IsVisible="False">
      <wf:ToolStripMenuItem x:Name="mnuTop">
        <wf:ToolStripMenuItem x:Name="mnuConfigure"
                              Header="Recent repositories _settings">
          <MenuItem.Icon>
            <Image Source="{x:Static properties:Images.Settings}" />
          </MenuItem.Icon>
        </wf:ToolStripMenuItem>
      </wf:ToolStripMenuItem>
    </wf:MenuStrip>
    <wf:ColumnHeader x:Name="clmhdrPath"
                     Width="60"
                     SourceWidth="60"
                     IsVisible="False"
                     Text="Path" />
    <wf:ColumnHeader x:Name="clmhdrBranch"
                     Width="60"
                     SourceWidth="60"
                     IsVisible="False"
                     Text="Branch" />
    <wf:ColumnHeader x:Name="clmhdrCategory"
                     Width="60"
                     SourceWidth="60"
                     IsVisible="False"
                     Text="Category" />
  </Grid>
</UserControl>
