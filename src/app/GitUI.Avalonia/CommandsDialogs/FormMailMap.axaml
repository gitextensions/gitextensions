<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:GitUI.Compat"
        xmlns:editor="clr-namespace:GitUI.Editor"
        x:Class="GitUI.CommandsDialogs.FormMailMap"
        Width="634"
        Height="474"
        WindowStartupLocation="CenterOwner"
        Title="Edit .mailmap">
  <Grid x:Name="splitContainer1"
        ColumnDefinitions="381,4,*"
        TabIndex="0">
    <editor:FileViewer x:Name="_NO_TRANSLATE_MailMapText"
                       Grid.Column="0"
                       Margin="0"
                       TabIndex="0" />
    <GridSplitter Grid.Column="1"
                  ResizeDirection="Columns" />
    <Grid Grid.Column="2">
      <Button x:Name="Save"
              Classes="gitextensions-dialog-action"
              Width="75"
              Height="25"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,12,10"
              TabIndex="0"
              Content="Save" />
      <!-- Avalonia's access-key parser must not treat the mailmap example's literal underscore as a mnemonic. -->
      <Label x:Name="label1"
             Width="302"
             Height="171"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Margin="3,9,0,0"
             Padding="0"
             compat:TranslationCompat.ConvertMnemonics="False"
             TabIndex="1">
        <TextBlock Text="Edit the mailmap.&#10;This file is meant to correct usernames.&#10;&#10;Example:&#10;Henk Westhuis &lt;Henk@.(none)&gt;&#10;Henk Westhuis &lt;henk_westhuis@hotmail.com&gt;&#10;&#10;For more information run&#10;command &quot;git help shortlog&quot;" />
      </Label>
    </Grid>
  </Grid>
</Window>
