<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gitui="clr-namespace:GitUI"
        xmlns:editor="clr-namespace:GitUI.Editor"
        x:Class="GitUI.CommandsDialogs.FormLog"
        Width="750"
        Height="529"
        MinWidth="250"
        MinHeight="250"
        WindowStartupLocation="CenterOwner"
        Title="Diff">
  <Grid x:Name="splitContainer1"
        RowDefinitions="205*,5,319*">
    <gitui:RevisionGridControl x:Name="RevisionGrid" Grid.Row="0" />
    <GridSplitter Grid.Row="1"
                  Height="5"
                  ResizeDirection="Rows" />
    <Grid x:Name="splitContainer3"
          Grid.Row="2"
          ColumnDefinitions="188,4,*">
      <gitui:FileStatusList x:Name="DiffFiles" Grid.Column="0" />
      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns" />
      <editor:FileViewer x:Name="diffViewer" Grid.Column="2" />
    </Grid>
  </Grid>
</Window>
